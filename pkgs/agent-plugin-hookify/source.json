  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "support@anthropic.com",
      "name": "Anthropic"
    },
    "description": "Easily create custom hooks to prevent unwanted behaviors by analyzing conversation patterns or from explicit instructions. Define rules via simple markdown files.",
    "homepage": "https://github.com/anthropics/claude-plugins-public/tree/main/plugins/hookify",
    "name": "hookify"
  },
  "skills": {
    "writing-rules": "plugins/hookify/skills/writing-rules"
  },
  "requiredRuntimes": [
    "python3"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/agents": "plugins/hookify/agents",
    "com.anthropic.claude-code/commands": "plugins/hookify/commands",
    "com.anthropic.claude-code/hooks": "plugins/hookify/hooks",
    "examples": "plugins/hookify/examples"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/userpromptsubmit.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Easily create custom hooks to prevent unwanted behaviors by analyzing conversation patterns or from explicit instructions",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [],
    "warnings": [
      {
        "path": "plugins/hookify/skills/writing-rules/SKILL.md",
        "message": "unknown frontmatter fields: version"
      },
      {
        "path": "plugins/hookify/skills/writing-rules/SKILL.md/name",
        "message": "skill name \"writing-hookify-rules\" must match directory name \"writing-rules\""
      },
      {
        "path": "plugins/hookify/hooks/hooks.json",
        "message": "Claude Code runs this on PostToolUse: python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse.py\""
      },
      {
        "path": "plugins/hookify/hooks/hooks.json",
        "message": "Claude Code runs this on PreToolUse: python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.py\""
      },
      {
        "path": "plugins/hookify/hooks/hooks.json",
        "message": "Claude Code runs this on Stop: python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.py\""
      },
      {
        "path": "plugins/hookify/hooks/hooks.json",
        "message": "Claude Code runs this on UserPromptSubmit: python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/userpromptsubmit.py\""
      },
      {
