{
  "name": "azure-cost",
  "version": "1.0.22",
  "src": {
    "owner": "microsoft",
    "repo": "skills",
    "rev": "18e05b845d43e869b5701d796abce6e9a49e57db",
    "hash": "sha256-9m/tiEGwHBr8oYKxsp1rCQVLtRmoNw3n/JVR+UKgrzg="
  },
  "sourceUrl": "https://github.com/microsoft/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Microsoft",
      "url": "https://www.microsoft.com"
    },
    "description": "Azure cost analysis, estimation, optimization, and governance workflows backed by Azure Resource Manager MCP.",
    "homepage": "https://github.com/microsoft/github-copilot-for-azure",
    "keywords": [
      "azure",
      "cost-management",
      "analysis",
      "estimation",
      "optimization",
      "budgets",
      "governance",
      "commitments"
    ],
    "license": "MIT",
    "name": "azure-cost",
    "repository": "https://github.com/microsoft/GitHub-Copilot-for-Azure",
    "version": "1.0.22"
  },
  "skills": {
    "cost-analysis": ".github/plugins/azure-cost/skills/cost-analysis",
    "cost-estimation": ".github/plugins/azure-cost/skills/cost-estimation",
    "cost-governance": ".github/plugins/azure-cost/skills/cost-governance",
    "cost-optimization": ".github/plugins/azure-cost/skills/cost-optimization"
  },
  "requiredRuntimes": [
    "bash"
  ],
  "dependencies": [
    "powershell"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": ".github/plugins/azure-cost/hooks"
  },
  "mcpServers": {
    "azure-resource-manager-mcp": {
      "headers": {
        "x-mcp-toolset": "CostManagement"
      },
      "type": "streamable-http",
      "url": "https://mcp.management.azure.com"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Azure cost analysis, estimation, optimization, and governance workflows backed by Azure Resource Manager MCP",
    "homepage": "https://github.com/microsoft/skills"
  },
  "import": {
    "input": "microsoft/skills",
    "flags": [
      "--dependency=powershell",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".github/skills",
        "message": "13 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": ".github/plugins/azure-cost/hooks/claude-hooks.json",
        "message": "Claude Code runs this on PostToolUse: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code"
      },
      {
        "path": ".github/plugins/azure-cost/hooks/claude-hooks.json",
        "message": "Claude Code runs this on SessionStart: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code"
      },
      {
        "path": "com.anthropic.claude-code/hooks/scripts/pluginPathAllowPattern.sh",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      }
    ]
  }
}
