{
  "name": "dotnet",
  "version": "0.2.5",
  "src": {
    "owner": "dotnet",
    "repo": "skills",
    "rev": "9837da685079d576feb27f9dd4f87631d3d94107",
    "hash": "sha256-hAV0Duw1TE/G7eMafIpJOmXY7DCFx8i/P5+VXs/YxHg="
  },
  "sourceUrl": "https://github.com/dotnet/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "description": "C# language server (LSP) integration for coding agents and high-level .NET development skills.",
    "extensions": {
      "com.anthropic.claude-code": {
        "lspServers": {
          "csharp": {
            "args": [
              "dnx",
              "roslyn-language-server",
              "--yes",
              "--prerelease",
              "--",
              "--stdio",
              "--daemon-mode",
              "--autoLoadProjects"
            ],
            "command": "dotnet",
            "extensionToLanguage": {
              ".cs": "csharp",
              ".cshtml": "aspnetcorerazor",
              ".razor": "aspnetcorerazor"
            }
          }
        }
      }
    },
    "name": "dotnet",
    "version": "0.2.5"
  },
  "skills": {
    "csharp-expert": "plugins/dotnet/skills/csharp-expert",
    "csharp-refactoring": "plugins/dotnet/skills/csharp-refactoring",
    "dotnet-breaking-changes": "plugins/dotnet/skills/dotnet-breaking-changes",
    "msbuild": "plugins/dotnet/skills/msbuild",
    "setup-local-sdk": "plugins/dotnet/skills/setup-local-sdk"
  },
  "requiredRuntimes": [
    "dotnet"
  ],
  "dependencies": [
    "dotnet-sdk_10"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "meta": {
    "description": "C# language server (LSP) integration for coding agents and high-level .NET development skills",
    "homepage": "https://github.com/dotnet/skills"
  },
  "import": {
    "input": "dotnet/skills",
    "flags": [
      "--dependency=dotnet-sdk_10",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".agents",
        "message": "5 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": ".github/skills/agentic-workflows/SKILL.md",
        "message": "outside every imported plugin, not imported; --plugin .github/skills/agentic-workflows=NAME imports it"
      },
      {
        "path": "eng",
        "message": "2 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": "plugins/dotnet/.lsp.json/csharp",
        "message": "Claude Code starts this language server for .cs, .cshtml, .razor files: dotnet dnx roslyn-language-server --yes --prerelease -- --stdio --daemon-mode --autoLoadProjects"
      }
    ]
  }
}
