    "description": "Twelve drop-in agent skills for YouTube transcripts, captions, subtitles, video and channel search, playlists and channel browsing, powered by the TranscriptAPI service.",
    "extensions": {
      "com.openai": {
        "interface": {
          "brandColor": "#CC2F02",
          "capabilities": [
            "Read",
            "Interactive"
          ],
          "category": "Productivity",
          "composerIcon": "./com.openai/assets/icon.svg",
          "defaultPrompt": [
            "Summarize this YouTube video for me.",
            "Get the transcript of this YouTube link.",
            "Find recent videos about a topic and pull their transcripts."
          ],
          "developerName": "Zero Point Studio",
          "displayName": "YouTube Skills by TranscriptAPI",
          "logo": "./com.openai/assets/icon.svg",
          "longDescription": "A set of twelve agent skills that give any skills-compatible agent reliable access to YouTube video transcripts, timestamped captions and subtitles, video and channel search, playlist contents and within-channel search through the TranscriptAPI service. Each skill ships with trigger vocabulary, exact API usage and error handling, so agents call the right endpoint on the first try. Sign up at transcriptapi.com for an API key (100 free credits, no card, one-time). TranscriptAPI is a third-party, independent service. It is not affiliated with, endorsed by, or sponsored by YouTube or Google.",
          "privacyPolicyURL": "https://transcriptapi.com/privacy",
          "screenshots": [
            "./com.openai/assets/screenshot-transcriptapi.png"
          ],
          "shortDescription": "YouTube transcripts, captions, search and channel data as agent skills.",
          "termsOfServiceURL": "https://transcriptapi.com/terms",
          "websiteURL": "https://transcriptapi.com"
        },
        "name": "youtube-skills",
        "skills": "./skills/"
      }
    },
    "homepage": "https://transcriptapi.com",
