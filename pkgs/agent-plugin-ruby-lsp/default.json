    "ruby-lsp"
  ],
  "dependencies": [
    "pyright",
    "clang-tools",
    "jdt-language-server"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "meta": {
    "description": "Ruby language server for code intelligence and analysis",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
