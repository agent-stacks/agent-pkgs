  },
  "sourceUrl": "https://github.com/langchain-ai/langchain-skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "LangChain",
      "url": "https://langchain.com"
    },
    "description": "Skills for LangChain application development, LangSmith workflows, and Harbor evaluation, with current documentation MCP access",
    "extensions": {
      "com.openai": {
        "interface": {
          "brandColor": "#030710",
          "brandColorDark": "#7FC8FF",
          "capabilities": [
            "Read"
          ],
          "category": "Developer Tools",
          "composerIcon": "./com.openai/assets/icon.png",
          "defaultPrompt": [
            "Help me build an agent with the LangChain ecosystem.",
            "Add LangSmith tracing to this agent.",
            "Set up evals for this agent."
          ],
          "developerName": "LangChain",
          "displayName": "LangChain Skills",
          "logo": "./com.openai/assets/icon.png",
          "longDescription": "Skills for building with Deep Agents, LangGraph, and LangChain; working with LangSmith traces, evaluations, and feedback; and engineering Harbor benchmarks, bundled with official documentation MCP connections.",
          "privacyPolicyURL": "https://www.langchain.com/privacy-policy",
          "shortDescription": "Build and evaluate agents",
          "supportURL": "https://github.com/langchain-ai/langchain-skills/issues",
          "termsOfServiceURL": "https://www.langchain.com/terms-of-service",
          "websiteURL": "https://docs.langchain.com"
        },
        "mcpServers": "./com.openai/.mcp.json",
        "skills": [
          "./skills/langchain-agent-experiments",
          "./skills/langchain-agent-monitoring",
          "./skills/langchain-agent-tracing",
          "./skills/langchain-build-agent",
          "./skills/langchain-eval-engineering",
          "./skills/langchain-managed-deep-agents"
        ]
      }
    },
    "homepage": "https://github.com/langchain-ai/langchain-skills",
    "keywords": [
      "langchain",
      "langgraph",
      "deep-agents",
      "ai-agents",
      "rag"
    ],
    "license": "MIT",
    "name": "langchain-skills",
    "repository": "https://github.com/langchain-ai/langchain-skills",
    "version": "0.4.4"
  },
  "skills": {
    "eval-engineering": "config/skills/eval-engineering",
    "langchain-agent-experiments": "skills/langchain-agent-experiments",
    "langchain-agent-monitoring": "skills/langchain-agent-monitoring",
    "langchain-agent-tracing": "skills/langchain-agent-tracing",
    "langchain-build-agent": "skills/langchain-build-agent",
    "langchain-eval-engineering": "skills/langchain-eval-engineering",
    "langchain-managed-deep-agents": "skills/langchain-managed-deep-agents",
    "managed-deep-agents": "config/skills/managed-deep-agents"
  },
  "requiredRuntimes": [
    "python3"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.openai/.mcp.json": ".mcp.json",
    "com.openai/assets": "assets"
  },
  "mcpServers": {
    "langchain-docs": {
      "type": "streamable-http",
      "url": "https://docs.langchain.com/mcp"
    },
    "langchain-reference": {
      "type": "streamable-http",
      "url": "https://reference.langchain.com/mcp"
    }
  },
  "meta": {
    "description": "Skills for LangChain application development, LangSmith workflows, and Harbor evaluation",
    "homepage": "https://github.com/langchain-ai/langchain-skills"
  },
  "import": {
    "input": "langchain-ai/langchain-skills",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "config/skills/eval-engineering/SKILL.md",
        "message": "missing YAML frontmatter (file must open with --- and close with ---)"
      },
      {
        "path": "config/skills/managed-deep-agents/SKILL.md",
        "message": "missing YAML frontmatter (file must open with --- and close with ---)"
      },
      {
        "path": "skills/.legacy",
        "message": "22 SKILL.md in a dot directory the search does not enter, not imported"
      },
      {
        "path": "skills/langchain-eval-engineering/references/multi-turn-simulation/harbor_example.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "skills/langchain-eval-engineering/references/multi-turn-simulation/model_user.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "skills/langchain-eval-engineering/references/multi-turn-simulation/runner.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "pyproject.toml",
        "message": "declares dependencies import does not package; package them in this package's custom block, using python3.withPackages"
      }
    ]
  }
}
