{
  "name": "agentmemory",
  "version": "0.9.32",
  "src": {
    "owner": "rohitg00",
    "repo": "agentmemory",
    "rev": "ad14556dca578937381f59edd39e2787fb09d2f3",
    "hash": "sha256-hLkcfgSPZaFYc9P1kQOeuvV1HdUcjZw25AV13r+5s9o="
  },
  "sourceUrl": "https://github.com/rohitg00/agentmemory",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Rohit Ghumare",
      "url": "https://github.com/rohitg00"
    },
    "description": "Persistent memory for AI coding agents -- captures tool usage, compresses via LLM, injects context into future sessions",
    "homepage": "https://github.com/rohitg00/agentmemory",
    "license": "Apache-2.0",
    "name": "agentmemory",
    "repository": "https://github.com/rohitg00/agentmemory",
    "version": "0.9.32"
  },
  "skills": {
    "agentmemory-agents": "plugin/skills/agentmemory-agents",
    "agentmemory-architecture": "plugin/skills/agentmemory-architecture",
    "agentmemory-config": "plugin/skills/agentmemory-config",
    "agentmemory-hooks": "plugin/skills/agentmemory-hooks",
    "agentmemory-mcp-tools": "plugin/skills/agentmemory-mcp-tools",
    "agentmemory-rest-api": "plugin/skills/agentmemory-rest-api",
    "commit-context": "plugin/skills/commit-context",
    "commit-history": "plugin/skills/commit-history",
    "forget": "plugin/skills/forget",
    "handoff": "plugin/skills/handoff",
    "lesson": "plugin/skills/lesson",
    "memory-discipline": "plugin/skills/memory-discipline",
    "recall": "plugin/skills/recall",
    "recap": "plugin/skills/recap",
    "remember": "plugin/skills/remember",
    "session-history": "plugin/skills/session-history",
    "write-agentmemory-skill": "plugin/skills/write-agentmemory-skill"
  },
  "requiredRuntimes": [
    "node"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "plugin/hooks",
    "scripts": "plugin/scripts"
  },
  "mcpServers": {
    "agentmemory": {
      "args": [
        "${PLUGIN_ROOT}/scripts/plugin-bridge.mjs"
      ],
      "command": "node",
      "env": {
        "CLAUDE_PLUGIN_OPTION_AGENTMEMORY_SECRET": "${user_config.agentmemory_secret}",
        "CLAUDE_PLUGIN_OPTION_AGENTMEMORY_URL": "${user_config.agentmemory_url}"
      },
      "type": "stdio"
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/notification.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-use.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-failure.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/pre-compact.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/pre-tool-use.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Read|Glob|Grep"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-end.mjs"
            ],
            "command": "node",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stop.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/subagent-start.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/subagent-stop.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/task-completed.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/prompt-submit.mjs"
            ],
            "command": "node",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Persistent memory for AI coding agents",
    "homepage": "https://github.com/rohitg00/agentmemory"
  },
  "import": {
    "input": "rohitg00/agentmemory",
