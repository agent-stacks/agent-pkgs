{
  "name": "orca-typescript",
  "version": "1.0.0",
  "src": {
    "owner": "stablyai",
    "repo": "orca",
    "rev": "3e0b7f791a28c73e6e89c65b28a4deb75d578cf4",
    "hash": "sha256-ClFORg5jZW7x25/rzqGvM/cDA6mbT71B2IPLhtNTMpI="
  },
  "sourceUrl": "https://github.com/stablyai/orca",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Orca"
    },
    "description": "TypeScript 7 diagnostics and code navigation from the repo's own compiler",
    "extensions": {
      "com.anthropic.claude-code": {
        "lspServers": {
          "orca-typescript": {
            "args": [
              "${CLAUDE_PROJECT_DIR}/config/scripts/typecheck/language-server/agent-typescript-lsp.mjs"
            ],
            "command": "node",
            "extensionToLanguage": {
              ".cjs": "javascript",
              ".cts": "typescript",
              ".js": "javascript",
              ".jsx": "javascriptreact",
              ".mjs": "javascript",
              ".mts": "typescript",
              ".ts": "typescript",
              ".tsx": "typescriptreact"
            },
            "maxRestarts": 3,
            "startupTimeout": 60000
          }
        }
      }
    },
    "name": "orca-typescript",
    "version": "1.0.0"
  },
  "skills": {},
  "requiredRuntimes": [
    "node"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "meta": {
    "description": "TypeScript 7 diagnostics and code navigation from the repo's own compiler",
    "homepage": "https://github.com/stablyai/orca"
  },
  "import": {
    "input": "stablyai/orca",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "skills",
        "message": "11 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": "config/agent-plugins/orca-typescript/.lsp.json/orca-typescript",
        "message": "Claude Code starts this language server for .cjs, .cts, .js, .jsx, .mjs, .mts, .ts, .tsx files: node ${CLAUDE_PROJECT_DIR}/config/scripts/typecheck/language-server/agent-typescript-lsp.mjs"
      }
    ]
  }
}
