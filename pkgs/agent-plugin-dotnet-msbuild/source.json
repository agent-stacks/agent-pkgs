      "args": [
        "dnx",
        "Microsoft.AITools.BinlogMcp",
        "--yes",
        "--prerelease"
      ],
      "command": "dotnet",
      "type": "stdio"
    }
  },
  "meta": {
    "description": "Comprehensive MSBuild and .NET build skills",
    "homepage": "https://github.com/dotnet/skills"
  },
  "import": {
    "input": "dotnet/skills",
    "flags": [
      "--dependency=dotnet-sdk_10"
    ],
    "warnings": [
      {
        "path": ".agents",
        "message": "5 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": ".github/skills/agentic-workflows/SKILL.md",
        "message": "outside every imported plugin, not imported; --plugin .github/skills/agentic-workflows=NAME imports it"
      },
      {
        "path": "eng",
        "message": "2 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": ".claude-plugin/marketplace.json",
        "message": "entry \"dotnet-msbuild\": mcpServers does not apply beside plugins/dotnet-msbuild/.claude-plugin/plugin.json, which Claude Code reads instead, not imported"
      }
    ]
