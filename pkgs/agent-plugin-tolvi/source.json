{
  "name": "tolvi",
  "version": "0.6.0",
  "src": {
    "owner": "tolvi-labs",
    "repo": "tolvi",
    "rev": "e9ae9b9bfd299858684b49c6845ecf55d1cd4cea",
    "hash": "sha256-1yoNwQ1bOCTArPxStRzIvnXd7lyJVY3o3qnLEcmVyFg="
  },
  "sourceUrl": "https://github.com/tolvi-labs/tolvi",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Tolvi Labs"
    },
    "description": "Read, write, and ask questions of a Tolvi engineering vault: decisions, sessions and patterns as plain Markdown your agents read as context.",
    "extensions": {
      "com.anthropic.claude-code": {
        "commands": [
          "./skills/tolvi/commands/tolvi-recall.md",
          "./skills/tolvi/commands/tolvi-sync.md",
          "./skills/tolvi/commands/tolvi-commit.md"
        ]
      }
    },
    "homepage": "https://tolvilabs.com/",
    "keywords": [
      "vault",
      "decisions",
      "context",
      "engineering-memory"
    ],
    "license": "Apache-2.0",
    "name": "tolvi",
    "repository": "https://github.com/tolvi-labs/tolvi",
    "version": "0.6.0"
  },
  "skills": {
    "files": "cli/internal/integrations/files",
    "tolvi": "skills/tolvi"
  },
  "requiredRuntimes": [
    "bash"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "hooks"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/tolvi/hooks/tolvi-sync",
            "if": "Bash(git commit*)",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/tolvi/hooks/tolvi-recall",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  },
  "meta": {
    "description": "Read, write, and ask questions of a Tolvi engineering vault",
    "homepage": "https://github.com/tolvi-labs/tolvi"
  },
  "import": {
    "input": "tolvi-labs/tolvi",
    "flags": [],
    "warnings": [
      {
        "path": "cli/internal/integrations/files/SKILL.md/name",
        "message": "skill name \"tolvi\" must match directory name \"files\""
      },
      {
        "path": "skills/tolvi/SKILL.md/name",
        "message": "skill name \"tolvi\" is also declared by the skill in directory \"files\""
      },
      {
        "path": "hooks/hooks.json",
        "message": "Claude Code runs this on PreToolUse: \"${CLAUDE_PLUGIN_ROOT}\"/skills/tolvi/hooks/tolvi-sync"
      },
      {
        "path": "hooks/hooks.json",
        "message": "Claude Code runs this on SessionStart: \"${CLAUDE_PLUGIN_ROOT}\"/skills/tolvi/hooks/tolvi-recall"
      },
      {
        "path": "package.json",
        "message": "dependency manifest; the build does not resolve what it declares"
      }
    ]
  }
}
