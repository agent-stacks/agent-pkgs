{
  "name": "ponytail",
  "version": "5.3.3",
  "src": {
    "owner": "DietrichGebert",
    "repo": "ponytail",
    "rev": "96608e078b2d5ea607c5c3b8b5a54d1c1fba6846",
    "hash": "sha256-PhPtZbeX2wBp19GtWRy+fV93+fFYZe5S487eXPDl/us="
  },
  "sourceUrl": "https://github.com/DietrichGebert/ponytail",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Dietrich Gebert",
      "url": "https://github.com/DietrichGebert"
    },
    "description": "Forces the laziest solution that works. YAGNI, stdlib first, one line over fifty.",
    "extensions": {
      "com.anthropic.claude-code": {
        "types": "./hooks/band/types.d.ts"
      }
    },
    "name": "ponytail",
    "version": "5.3.3"
  },
  "skills": {
    "ponytail": "skills/ponytail",
    "ponytail-audit": "skills/ponytail-audit",
    "ponytail-debt": "skills/ponytail-debt",
    "ponytail-gain": "skills/ponytail-gain",
    "ponytail-help": "skills/ponytail-help",
    "ponytail-review": "skills/ponytail-review"
  },
  "requiredRuntimes": [
    "bash",
    "node"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "hooks"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-activate.js'))\"",
            "statusMessage": "Loading ponytail mode...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-subagent.js'))\"",
            "statusMessage": "Loading ponytail mode...",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-mode-tracker.js'))\"",
            "statusMessage": "Tracking ponytail mode...",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Forces the laziest solution that works",
    "homepage": "https://github.com/DietrichGebert/ponytail"
  },
  "import": {
    "input": "DietrichGebert/ponytail",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".openclaw/skills/ponytail",
        "message": "skill \"ponytail\" already found at skills/ponytail, not imported"
      },
      {
        "path": ".openclaw/skills/ponytail-audit",
        "message": "skill \"ponytail-audit\" already found at skills/ponytail-audit, not imported"
      },
      {
        "path": ".openclaw/skills/ponytail-debt",
        "message": "skill \"ponytail-debt\" already found at skills/ponytail-debt, not imported"
      },
      {
        "path": ".openclaw/skills/ponytail-gain",
        "message": "skill \"ponytail-gain\" already found at skills/ponytail-gain, not imported"
      },
      {
        "path": ".openclaw/skills/ponytail-help",
        "message": "skill \"ponytail-help\" already found at skills/ponytail-help, not imported"
      },
      {
        "path": ".openclaw/skills/ponytail-review",
        "message": "skill \"ponytail-review\" already found at skills/ponytail-review, not imported"
      },
      {
        "path": "hooks/claude-band.json",
        "message": "modules: Claude Code loads the modules of hooks/hooks.json only; not packaged"
      },
      {
        "path": "skills/ponytail/SKILL.md",
        "message": "unknown frontmatter fields: argument-hint"
      },
      {
        "path": "hooks/claude-codex-hooks.json",
        "message": "Claude Code runs this on SessionStart: node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-activate.js'))\""
      },
      {
        "path": "hooks/claude-codex-hooks.json",
        "message": "Claude Code runs this on SubagentStart: node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-subagent.js'))\""
      },
      {
        "path": "hooks/claude-codex-hooks.json",
        "message": "Claude Code runs this on UserPromptSubmit: node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-mode-tracker.js'))\""
      },
      {
        "path": "package.json",
        "message": "declares dependencies import does not package; package them in this package's custom block; with no lockfile beside it, nothing pins the versions"
      }
    ]
  }
}
