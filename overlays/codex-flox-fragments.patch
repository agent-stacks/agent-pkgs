 use codex_core_plugin_common::installed::RemotePluginInstallMetadata;
 
+const FLOX_PLUGIN_VERSION: &str = "flox";
+
+// flox-ai: CODEX_FLOX_PLUGIN_ROOT names a folder laid out as
+// <marketplace>/<plugin>/. A plugin with a folder there loads from it
+// instead of the cache, so `agent-stacks launch codex` can hand Codex
+// plugins for one process without writing the plugin cache. Added by the
+// flox downstream patch.
+//
+// The folder is canonicalized because hook fingerprinting refuses a
+// plugin root that is a link.
+pub(crate) fn flox_plugin_root(plugin_id: &PluginId) -> Option<AbsolutePathBuf> {
+    let raw = std::env::var_os("CODEX_FLOX_PLUGIN_ROOT")?;
+    let root = AbsolutePathBuf::from_absolute_path_checked(PathBuf::from(raw)).ok()?;
+    let root = root
+        .join(&plugin_id.marketplace_name)
+        .join(&plugin_id.plugin_name)
+        .canonicalize()
+        .ok()?;
+    root.as_path().is_dir().then_some(root)
+}
