{
  "name": "pyright-lsp",
  "version": "1.0.0",
  "src": {
    "owner": "anthropics",
    "repo": "claude-plugins-official",
    "rev": "9bd776d78d956bd68520efe67ac6422a76f811f8",
    "hash": "sha256-e1GTUtgqohTAL35eyPd3MFhV6tM24tTDcHNtUgJz16U="
  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "support@anthropic.com",
      "name": "Anthropic"
    },
    "description": "Python language server (Pyright) for type checking and code intelligence",
    "extensions": {
      "com.anthropic.claude-code": {
        "lspServers": {
          "pyright": {
            "args": [
              "--stdio"
            ],
            "command": "pyright-langserver",
            "extensionToLanguage": {
              ".py": "python",
              ".pyi": "python"
            }
          }
        }
      }
    },
    "name": "pyright-lsp",
    "version": "1.0.0"
  },
  "skills": {},
  "requiredRuntimes": [
    "pyright-langserver"
  ],
  "dependencies": [
    "pyright",
    "clang-tools",
    "jdt-language-server"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "meta": {
    "description": "Python language server (Pyright) for type checking and code intelligence",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [
      "--dependency=pyright",
      "--dependency=clang-tools",
      "--dependency=jdt-language-server",
      "--path-ignore=external_plugins/context7",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".claude-plugin/marketplace.json",
        "message": "entry \"pyright-lsp\": lspServers does not apply beside plugins/pyright-lsp/.claude-plugin/plugin.json, which Claude Code reads instead, not imported"
      },
      {
        "path": "plugins/pyright-lsp/.claude-plugin/plugin.json/lspServers/pyright",
        "message": "Claude Code starts this language server for .py, .pyi files: pyright-langserver --stdio"
      }
    ]
  }
}
