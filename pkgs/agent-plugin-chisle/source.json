{
  "name": "chisle",
  "version": "3.7.0",
  "src": {
    "owner": "JayPokale",
    "repo": "Chisle",
    "rev": "b0fde39bbc2901683d27114071b5954c2799430a",
    "hash": "sha256-yIG96ATqjMZEyCkHLaezALtZLslX9yJDDKLS9n9Rt6s="
  },
  "sourceUrl": "https://github.com/JayPokale/Chisle",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "description": "Maximum signal. Minimum noise. Write less. Ship less. Mean more.",
    "name": "chisle",
    "version": "3.7.0"
  },
  "skills": {
    "chisle": "skills/chisle",
    "chisle-audit": "skills/chisle-audit",
    "chisle-help": "skills/chisle-help",
    "chisle-review": "skills/chisle-review"
  },
  "requiredRuntimes": [
    "bash",
    "node"
  ],
  "pluginRootPaths": {
    "bin": "bin",
    "com.anthropic.claude-code/hooks": "hooks"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/chisle-compress-output.js\"; exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\chisle-compress-output.js\" }",
            "statusMessage": "Compressing tool output...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Agent|WebFetch|WebSearch|Grep|Glob|mcp__.*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/chisle-activate.js\"; exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\chisle-activate.js\" }",
            "statusMessage": "Loading chisle mode...",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/chisle-mode-tracker.js\"; exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\chisle-mode-tracker.js\" }",
            "statusMessage": "Tracking chisle mode...",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Maximum signal",
    "homepage": "https://github.com/JayPokale/Chisle"
  },
  "import": {
    "input": "JayPokale/Chisle",
    "flags": [],
    "warnings": [
      {
        "path": ".claude-plugin/plugin.json",
        "message": "Claude Code runs this on PostToolUse: node \"${CLAUDE_PLUGIN_ROOT}/hooks/chisle-compress-output.js\"; exit 0"
      },
      {
        "path": ".claude-plugin/plugin.json",
        "message": "Claude Code runs this on SessionStart: node \"${CLAUDE_PLUGIN_ROOT}/hooks/chisle-activate.js\"; exit 0"
      },
      {
        "path": ".claude-plugin/plugin.json",
        "message": "Claude Code runs this on UserPromptSubmit: node \"${CLAUDE_PLUGIN_ROOT}/hooks/chisle-mode-tracker.js\"; exit 0"
      },
      {
        "path": "bin",
        "message": "Claude Code puts these on the Bash tool's PATH: install.js"
      },
      {
        "path": "com.anthropic.claude-code/hooks/package.json",
        "message": "dependency manifest; the build does not resolve what it declares"
      },
      {
        "path": "package.json",
        "message": "dependency manifest; the build does not resolve what it declares"
      }
    ]
  }
}
