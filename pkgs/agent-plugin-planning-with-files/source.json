    "name": "planning-with-files",
    "repository": "https://github.com/OthmanAdi/planning-with-files",
    "version": "3.24.0"
  },
  "skills": {
    "planning-with-files": ".agents/skills/planning-with-files",
    "planning-with-files-ar": "skills/i18n/planning-with-files-ar",
    "planning-with-files-de": "skills/i18n/planning-with-files-de",
    "planning-with-files-es": "skills/i18n/planning-with-files-es",
    "planning-with-files-zh": "skills/i18n/planning-with-files-zh",
    "planning-with-files-zht": "skills/i18n/planning-with-files-zht"
  },
  "requiredRuntimes": [
    "bash",
    "python3",
    "sh"
  ],
  "pluginRootPaths": {
    ".codex": ".codex",
    "com.anthropic.claude-code/commands": "commands",
    "com.anthropic.claude-code/hooks": "hooks",
    "scripts": "scripts",
    "templates": "templates"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh",
              "post-tool-use"
            ],
            "command": "sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh",
              "pre-compact"
            ],
            "command": "sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh",
              "pre-tool-use"
            ],
            "command": "sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|Bash|Read|Glob|Grep"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh",
              "session-start"
            ],
            "command": "sh",
            "statusMessage": "Restoring planning context",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh",
              "stop"
            ],
            "command": "sh",
            "statusMessage": "Checking planning completion",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh",
              "user-prompt-submit"
            ],
            "command": "sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Persistent project planning files with lifecycle hooks that inject selected plan context",
    "homepage": "https://github.com/othmanadi/planning-with-files"
  },
