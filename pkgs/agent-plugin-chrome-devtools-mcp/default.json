{
  "name": "chrome-devtools-mcp",
  "version": "1.14.0",
  "src": {
    "owner": "ChromeDevTools",
    "repo": "chrome-devtools-mcp",
    "rev": "3c403591a7011c1371c6f584a1d1c213a75c4746",
    "hash": "sha256-FG1XsT3UlrsEdpGJHF3NpM1HAlaa0g6IQMYlBrlMPQI="
  },
  "sourceUrl": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Google Chrome",
      "url": "https://developer.chrome.com/"
    },
    "description": "Reliable Chrome automation, debugging, and performance analysis for AI agents.",
    "extensions": {
      "com.openai": {
        "interface": {
          "brandColor": "#1A73E8",
          "capabilities": [
            "Interactive",
            "Read",
            "Write"
          ],
          "category": "Coding",
          "defaultPrompt": [
            "Check the performance of https://developers.chrome.com",
            "Debug the failing network request on the selected page",
            "Take a screenshot and list console errors"
          ],
          "developerName": "Chrome DevTools",
          "displayName": "Chrome DevTools",
          "longDescription": "Give your coding agent reliable Chrome automation, in-depth debugging, and performance analysis through Chrome DevTools and Puppeteer. Inspect pages, capture traces, debug console and network issues, and verify UI changes before you ship.",
          "shortDescription": "Automate, debug, and analyze Chrome with DevTools",
          "websiteURL": "https://developer.chrome.com/docs/devtools/agents"
        },
        "mcpServers": {
          "chrome-devtools": {
            "args": [
              "chrome-devtools-mcp@1.14.0"
            ],
            "command": "npx"
          }
        },
        "skills": "./skills/"
      }
    },
    "homepage": "https://developer.chrome.com/docs/devtools/agents",
    "keywords": [
      "browser",
      "chrome",
      "debugging",
      "mcp",
      "performance"
    ],
    "license": "Apache-2.0",
    "name": "chrome-devtools-mcp",
    "repository": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
    "version": "1.14.0"
  },
  "skills": {
    "a11y-debugging": "skills/a11y-debugging",
    "chrome-devtools": "skills/chrome-devtools",
    "chrome-devtools-cli": "skills/chrome-devtools-cli",
    "cookie-debugging": "skills/cookie-debugging",
    "debug-optimize-lcp": "skills/debug-optimize-lcp",
    "inspect-in-devtools": "skills/inspect-in-devtools",
    "memory-leak-debugging": "skills/memory-leak-debugging",
    "troubleshooting": "skills/troubleshooting"
  },
  "requiredRuntimes": [
    "npx"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "--prefix",
        "${PLUGIN_DATA}",
        "chrome-devtools-mcp@1.14.0"
      ],
      "command": "npx",
      "type": "stdio"
    }
  },
  "meta": {
    "description": "Reliable Chrome automation, debugging, and performance analysis for AI agents",
    "homepage": "https://github.com/ChromeDevTools/chrome-devtools-mcp"
  },
  "import": {
    "input": "ChromeDevTools/chrome-devtools-mcp",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".codex-plugin/plugin.json",
        "message": "interface.composerIcon: \"https://github.com/ChromeDevTools/devtools-logo/blob/master/logos/svg/chrome-devtools-square-responsive.svg\" does not start with \"./\", so Codex ignores it"
      },
      {
        "path": ".codex-plugin/plugin.json",
        "message": "interface.logo: \"https://github.com/ChromeDevTools/devtools-logo/blob/master/logos/svg/chrome-devtools-square-responsive.svg\" does not start with \"./\", so Codex ignores it"
      }
    ]
  }
}
