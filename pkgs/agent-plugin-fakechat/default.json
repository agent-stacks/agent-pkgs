{
  "name": "fakechat",
  "version": "0.0.1",
  "src": {
    "owner": "anthropics",
    "repo": "claude-plugins-official",
    "rev": "10759d7fff7d18eecf689010d3fc2543b55bb7a9",
    "hash": "sha256-XckqK20ZPQq8Bk4dqHQTUjThpo/Arx9B6LI4JmF+mjY="
  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "description": "Localhost web chat for testing the channel notification flow. No tokens, no access control, no third-party service.",
    "keywords": [
      "fakechat",
      "web",
      "localhost",
      "testing",
      "channel",
      "mcp"
    ],
    "name": "fakechat",
    "version": "0.0.1"
  },
  "skills": {},
  "requiredRuntimes": [
    "bun"
  ],
  "dependencies": [
    "pyright",
    "clang-tools",
    "jdt-language-server"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "LICENSE": "external_plugins/fakechat/LICENSE",
    "README.md": "external_plugins/fakechat/README.md",
    "bun.lock": "external_plugins/fakechat/bun.lock",
    "package.json": "external_plugins/fakechat/package.json",
    "server.ts": "external_plugins/fakechat/server.ts"
  },
  "mcpServers": {
    "fakechat": {
      "args": [
        "run",
        "--cwd",
        "${PLUGIN_ROOT}",
        "--shell=bun",
        "--silent",
        "start"
      ],
      "command": "bun",
      "type": "stdio"
    }
  },
  "meta": {
    "description": "Localhost web chat for testing the channel notification flow",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [
      "--dependency=pyright",
      "--dependency=clang-tools",
      "--dependency=jdt-language-server",
      "--path-ignore=external_plugins/context7",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "external_plugins/fakechat",
        "message": "a server declared in external_plugins/fakechat/.mcp.json runs from the plugin root, so the root's files ship: LICENSE, README.md, bun.lock, package.json, server.ts"
      },
      {
        "path": "package.json",
        "message": "declares dependencies import does not package; package them in this package's custom block, using bun2nix for its bun.lock"
      }
    ]
  }
}
