    },
    "description": "Build third-party Power Apps Mobile (PAM) controls into a prebuilt .ppmplugin binary (Android DEX + flat iOS .framework + manifest.json) for the wrap runtime. Public tooling only; recommended build entry point /generate-ppmplugin.",
    "homepage": "https://github.com/microsoft/power-platform-skills/",
    "keywords": [
      "power-apps",
      "power-apps-mobile-extension",
      "pam",
      "control",
