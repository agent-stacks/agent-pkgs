{
  "name": "firebase",
  "version": "1.1.0",
  "src": {
    "owner": "firebase",
    "repo": "agent-skills",
    "rev": "99954a30898bb5ddc8152ee10e124dc3b4106bf7",
    "hash": "sha256-mNRkFXKaSPGj3rYc3402JYGyLdgmht6dl41vorPkiB4="
  },
  "sourceUrl": "https://github.com/firebase/agent-skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Firebase",
      "url": "https://firebase.google.com/"
    },
    "description": "Official Claude plugin for Firebase. Manage projects, add backend services, develop AI features, deploy & host apps, and more",
    "extensions": {
      "com.openai": {
        "interface": {
          "brandColor": "#FF9100",
          "capabilities": [
            "Skills",
            "MCP"
          ],
          "category": "Developer Tools",
          "composerIcon": "./com.openai/assets/firebase_logo.svg",
          "defaultPrompt": [
            "Set up Firebase in this app.",
            "Audit my Firestore security rules.",
            "Deploy this app with Firebase Hosting."
          ],
          "developerName": "Firebase",
          "displayName": "Firebase",
          "logo": "./com.openai/assets/firebase_logo.svg",
          "longDescription": "Use official Firebase skills and the Firebase MCP server to set up projects, configure backend services, query Firestore, manage authentication, deploy hosting, work with AI Logic, and audit security rules from Codex.",
          "privacyPolicyURL": "https://policies.google.com/privacy",
          "shortDescription": "Build and deploy apps faster",
          "supportURL": "https://firebase.google.com/support",
          "termsOfServiceURL": "https://policies.google.com/terms",
          "websiteURL": "https://firebase.google.com"
        },
        "mcpServers": "./com.openai/.mcp.json",
        "skills": "./skills/"
      }
    },
    "homepage": "https://github.com/firebase/firebase-tools",
    "keywords": [
      "firebase",
      "mcp",
      "cloud",
      "firestore",
      "database",
      "hosting",
      "functions",
      "cli"
    ],
    "license": "MIT",
    "name": "firebase",
    "repository": "https://github.com/firebase/firebase-tools.git",
    "version": "1.1.0"
  },
  "skills": {
    "extension-to-functions-codebase": "skills/extension-to-functions-codebase",
    "firebase-ai-logic-basics": "skills/firebase-ai-logic-basics",
    "firebase-analytics": "skills/firebase-analytics",
    "firebase-app-hosting-basics": "skills/firebase-app-hosting-basics",
    "firebase-auth-basics": "skills/firebase-auth-basics",
    "firebase-basics": "skills/firebase-basics",
    "firebase-crashlytics": "skills/firebase-crashlytics",
    "firebase-data-connect-basics": "skills/firebase-data-connect-basics",
    "firebase-firestore": "skills/firebase-firestore",
    "firebase-hosting-basics": "skills/firebase-hosting-basics",
    "firebase-remote-config-basics": "skills/firebase-remote-config-basics",
    "firebase-security-rules-auditor": "skills/firebase-security-rules-auditor",
    "firestore-rules-creation": "skills/firestore-rules-creation",
    "xcode-project-setup": "skills/xcode-project-setup"
  },
  "requiredRuntimes": [
    "npx"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/agents": "agents",
    "com.openai/.mcp.json": ".mcp.json",
    "com.openai/assets": "assets"
  },
  "mcpServers": {
    "firebase": {
      "args": [
        "-y",
        "firebase-tools@15.32.1",
        "mcp",
        "--dir",
        "."
      ],
      "command": "npx",
      "env": {
        "IS_FIREBASE_MCP": "true"
      },
      "type": "stdio"
    }
  },
  "meta": {
    "description": "Official Claude plugin for Firebase",
    "homepage": "https://github.com/firebase/agent-skills"
  },
  "import": {
    "input": "firebase/agent-skills",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "skills/firebase-ai-logic-basics/SKILL.md",
        "message": "unknown frontmatter fields: version"
      },
      {
        "path": "skills/firebase-analytics/SKILL.md",
        "message": "unknown frontmatter fields: version"
      },
      {
        "path": "skills/firebase-data-connect-basics/SKILL.md/name",
        "message": "skill name \"firebase-data-connect\" must match directory name \"firebase-data-connect-basics\""
      }
    ]
  }
}
