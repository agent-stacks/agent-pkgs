    "hash": "sha256-jKdKl7Jq4yF1nDrzaNJKX9cmnfxB/ftpRIQINA2TIXM="
  },
  "sourceUrl": "https://github.com/microsoft/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Microsoft",
      "url": "https://www.microsoft.com"
    },
    "description": "Kusto graph analysis, IRQL security hunting pipelines, and graph visualization skills for Azure Data Explorer.",
    "homepage": "https://github.com/microsoft/github-copilot-for-azure",
    "keywords": [
      "azure",
      "kusto",
      "graph",
      "irql",
      "security",
      "kql"
    ],
    "license": "MIT",
    "name": "azure-kusto-graph-skills",
    "repository": "https://github.com/microsoft/github-copilot-for-azure",
    "version": "1.0.29"
  },
  "skills": {
    "azure-kusto-graph": ".github/plugins/azure-kusto-graph-skills/skills/azure-kusto-graph",
    "azure-kusto-irql": ".github/plugins/azure-kusto-graph-skills/skills/azure-kusto-irql",
    "azure-kusto-irql-graph": ".github/plugins/azure-kusto-graph-skills/skills/azure-kusto-irql-graph"
  },
  "requiredRuntimes": [
    "bash",
    "npx"
  ],
  "dependencies": [
    "powershell"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": ".github/plugins/azure-kusto-graph-skills/hooks"
  },
  "mcpServers": {
    "azure": {
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "command": "npx",
      "type": "stdio"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Kusto graph analysis, IRQL security hunting pipelines, and graph visualization skills for Azure Data Explorer",
    "homepage": "https://github.com/microsoft/skills"
  },
  "import": {
    "input": "microsoft/skills",
    "flags": [
      "--dependency=powershell"
    ],
    "warnings": [
      {
        "path": ".github/skills",
        "message": "13 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": ".github/plugins/azure-kusto-graph-skills/hooks/claude-hooks.json",
        "message": "Claude Code runs this on PostToolUse: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\""
      },
      {
        "path": ".github/plugins/azure-kusto-graph-skills/hooks/claude-hooks.json",
        "message": "Claude Code runs this on SessionStart: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\""
      },
      {
        "path": "com.anthropic.claude-code/hooks/scripts/pluginPathAllowPattern.sh",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "com.anthropic.claude-code/hooks/scripts/track-telemetry.js",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      }
    ]
  }
}
