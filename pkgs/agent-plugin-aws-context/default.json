{
  "name": "aws-context",
  "version": "0.1.0",
  "src": {
    "owner": "aws",
    "repo": "agent-toolkit-for-aws",
    "rev": "e0f24ff1c20c12bdbdb5e92beb8a17dbd0dff872",
    "hash": "sha256-eABaLsh3C8J1DAMW4wvVQH5MnGygJXs/PBOIzweGJak="
  },
  "sourceUrl": "https://github.com/aws/agent-toolkit-for-aws",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Amazon Web Services"
    },
    "description": "Ground coding agents in your organization's knowledge with AWS Context: retrieve from your agent context graph, correct or extend it, and record sessions.",
    "extensions": {
      "com.openai": {
        "hooks": {},
        "interface": {
          "brandColor": "#FF9900",
          "capabilities": [
            "Read",
            "Write"
          ],
          "category": "Cloud",
          "defaultPrompt": [
            "Who owns the orders table?",
            "How do we calculate monthly active users?",
            "That table's description is wrong; fix it in AWS Context."
          ],
          "developerName": "Amazon Web Services",
          "displayName": "AWS Context",
          "longDescription": "Ground coding agents in your organization's knowledge with AWS Context: retrieve from your agent context graph, correct or extend it, and record sessions.",
          "privacyPolicyURL": "https://aws.amazon.com/privacy/",
          "shortDescription": "Ground your agent in your organization's knowledge with AWS Context",
          "termsOfServiceURL": "https://aws.amazon.com/service-terms/",
          "websiteURL": "https://github.com/aws/agent-toolkit-for-aws"
        },
        "mcpServers": "./com.openai/.mcp.json",
        "skills": "./skills/"
      }
    },
    "homepage": "https://aws.amazon.com/products/developer-tools/agent-toolkit-for-aws/",
    "keywords": [
      "aws",
      "aws-context",
      "knowledge-graph",
      "agent-context",
      "retrieval",
      "agentic-retrieval",
      "data-catalog",
      "glue",
      "bedrock-knowledge-bases"
    ],
    "license": "Apache-2.0",
    "name": "aws-context",
    "repository": "https://github.com/aws/agent-toolkit-for-aws/tree/main/plugins/aws-context",
    "version": "0.1.0"
  },
  "skills": {
    "aws-context": "plugins/aws-context/skills/aws-context"
  },
  "requiredRuntimes": [
    "python3"
  ],
  "dependencies": [
    "uv"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/commands": "plugins/aws-context/commands",
    "com.anthropic.claude-code/hooks": "plugins/aws-context/com.anthropic.claude-code/hooks",
    "com.openai/.mcp.json": "plugins/aws-context/.mcp.json"
  },
  "mcpServers": {
    "aws-context": {
      "type": "streamable-http",
      "url": "https://context-mcp.us-east-1.api.aws/mcp"
    }
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "sh -c 'python3 \"$0\" 2>/dev/null || python \"$0\" 2>/dev/null || py -3 \"$0\" 2>/dev/null || true' \"${CLAUDE_PLUGIN_ROOT}/com.anthropic.claude-code/hooks/session_feedback.py\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh -c 'python3 \"$0\" 2>/dev/null || python \"$0\" 2>/dev/null || py -3 \"$0\" 2>/dev/null || true' \"${CLAUDE_PLUGIN_ROOT}/com.anthropic.claude-code/hooks/context_steering.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Ground coding agents in your organization's knowledge with AWS Context",
    "homepage": "https://github.com/aws/agent-toolkit-for-aws"
  },
  "import": {
    "input": "aws/agent-toolkit-for-aws",
    "flags": [
      "--dependency=uv",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "plugins/aws-context/plugin.json",
        "message": "extensions.com.anthropic.claude-code held hooks; replaced by what import read for Claude Code, since Claude Code reads its own files and launch reads this block"
      },
      {
        "path": "skills",
        "message": "134 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": "plugins/aws-context/.codex-plugin/plugin.json",
        "message": "hooks: the Codex manifest names none, so Codex reads hooks/hooks.json alone, not what the Claude manifest adds; recorded so"
      },
      {
        "path": "plugins/aws-context/com.anthropic.claude-code/hooks/hooks.json",
        "message": "Claude Code runs this on SessionEnd: sh -c 'python3 \"$0\" 2>/dev/null || python \"$0\" 2>/dev/null || py -3 \"$0\" 2>/dev/null || true' \"${CLAUDE_PLUGIN_ROOT}/com.anthropic.claude-code/hooks/session_feedback.py\""
      },
      {
        "path": "plugins/aws-context/com.anthropic.claude-code/hooks/hooks.json",
        "message": "Claude Code runs this on UserPromptSubmit: sh -c 'python3 \"$0\" 2>/dev/null || python \"$0\" 2>/dev/null || py -3 \"$0\" 2>/dev/null || true' \"${CLAUDE_PLUGIN_ROOT}/com.anthropic.claude-code/hooks/context_steering.py\""
      },
      {
        "path": "com.anthropic.claude-code/hooks/hook_config.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      }
    ]
  }
}
