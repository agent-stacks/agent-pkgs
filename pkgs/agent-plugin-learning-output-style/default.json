{
  "name": "learning-output-style",
  "version": "1.0.1",
  "src": {
    "owner": "anthropics",
    "repo": "claude-plugins-official",
    "rev": "c4a79ce6b7c21a4b2ea908767f4adeab32695ae4",
    "hash": "sha256-phsS5zyzLx9HD27mIQ98j+HMT2RnDt4srJqOHBBj0c8="
  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "support@anthropic.com",
      "name": "Anthropic"
    },
    "description": "Interactive learning mode that requests meaningful code contributions at decision points (mimics the unshipped Learning output style)",
    "homepage": "https://github.com/anthropics/claude-plugins-public/tree/main/plugins/learning-output-style",
    "name": "learning-output-style",
    "version": "1.0.1"
  },
  "skills": {},
  "requiredRuntimes": [
    "bash"
  ],
  "dependencies": [
    "pyright",
    "clang-tools",
    "jdt-language-server"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "plugins/learning-output-style/hooks",
    "hooks-handlers": "plugins/learning-output-style/hooks-handlers"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Interactive learning mode that requests meaningful code contributions at decision points (mimics the unshipped Learning output style)",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [
      "--dependency=pyright",
      "--dependency=clang-tools",
      "--dependency=jdt-language-server",
      "--path-ignore=external_plugins/context7",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "plugins/learning-output-style/hooks/hooks.json",
        "message": "Claude Code runs this on SessionStart: bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh\""
      }
    ]
  }
}
