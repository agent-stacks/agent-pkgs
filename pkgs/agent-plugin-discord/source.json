{
  "name": "discord",
  "version": "0.0.4",
  "src": {
    "owner": "anthropics",
    "repo": "claude-plugins-official",
    "rev": "f8c5e7a1dcb71b10cb74586224b5401f3de5db28",
    "hash": "sha256-lmJbRtHsAN/rxqzm5hzxxu8lx+iiqRCtocJ7YET03Lg="
  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "description": "Discord messaging bridge with built-in access control. Manage pairing, allowlists, and policy via /discord:access.",
    "keywords": [
      "discord",
      "messaging",
      "channel",
      "mcp"
    ],
    "name": "discord",
    "version": "0.0.4"
  },
  "skills": {
    "access": "external_plugins/discord/skills/access",
    "configure": "external_plugins/discord/skills/configure"
  },
  "requiredRuntimes": [
    "bun"
  ],
  "pluginRootPaths": {
    "ACCESS.md": "external_plugins/discord/ACCESS.md",
    "LICENSE": "external_plugins/discord/LICENSE",
    "README.md": "external_plugins/discord/README.md",
    "bun.lock": "external_plugins/discord/bun.lock",
    "package.json": "external_plugins/discord/package.json",
    "server.ts": "external_plugins/discord/server.ts"
  },
  "mcpServers": {
    "discord": {
      "args": [
        "run",
        "--cwd",
        "${PLUGIN_ROOT}",
        "--shell=bun",
        "--silent",
        "start"
      ],
      "command": "bun",
      "type": "stdio"
    }
  },
  "meta": {
    "description": "Discord messaging bridge with built-in access control",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [
      "--path-ignore=external_plugins/context7"
    ],
    "warnings": [
      {
        "path": "external_plugins/discord/skills/access/SKILL.md",
        "message": "unknown frontmatter fields: user-invocable"
      },
      {
        "path": "external_plugins/discord/skills/access/SKILL.md/allowed-tools",
        "message": "must be a space-separated string, not a list (Read Write Bash(ls *) Bash(mkdir *))"
      },
      {
        "path": "external_plugins/discord/skills/configure/SKILL.md",
        "message": "unknown frontmatter fields: user-invocable"
      },
      {
        "path": "external_plugins/discord/skills/configure/SKILL.md/allowed-tools",
        "message": "must be a space-separated string, not a list (Read Write Bash(ls *) Bash(mkdir *))"
      },
      {
        "path": "external_plugins/discord",
        "message": "a server declared in external_plugins/discord/.mcp.json runs from the plugin root, so the root's files ship: ACCESS.md, LICENSE, README.md, bun.lock, package.json, server.ts"
      },
      {
        "path": "package.json",
        "message": "declares dependencies import does not package; package them in this package's custom block, using bun2nix for its bun.lock"
      }
    ]
  }
}
