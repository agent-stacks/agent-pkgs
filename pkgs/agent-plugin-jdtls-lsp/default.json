  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "support@anthropic.com",
      "name": "Anthropic"
    },
    "description": "Java language server (Eclipse JDT.LS) for code intelligence",
    "extensions": {
      "com.anthropic.claude-code": {
        "lspServers": {
          "jdtls": {
            "command": "jdtls",
            "extensionToLanguage": {
              ".java": "java"
            },
            "startupTimeout": 120000
          }
        }
      }
    },
    "name": "jdtls-lsp",
    "version": "1.0.0"
  },
  "skills": {},
  "requiredRuntimes": [
    "jdtls"
  ],
  "dependencies": [
    "pyright",
    "clang-tools",
    "jdt-language-server"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "meta": {
    "description": "Java language server (Eclipse JDT.LS) for code intelligence",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [
      "--dependency=pyright",
      "--dependency=clang-tools",
      "--dependency=jdt-language-server",
      "--path-ignore=external_plugins/context7",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".claude-plugin/marketplace.json",
        "message": "entry \"jdtls-lsp\": lspServers does not apply beside plugins/jdtls-lsp/.claude-plugin/plugin.json, which Claude Code reads instead, not imported"
      },
      {
        "path": "plugins/jdtls-lsp/.claude-plugin/plugin.json/lspServers/jdtls",
        "message": "Claude Code starts this language server for .java files: jdtls"
      }
    ]
  }
}
