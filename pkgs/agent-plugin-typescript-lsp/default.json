{
  "name": "typescript-lsp",
  "version": "1.0.0",
  "src": {
    "owner": "anthropics",
    "repo": "claude-plugins-official",
    "rev": "e0ab6e51219eef74e417a0e1d89e5d53e5e763d4",
    "hash": "sha256-7ddCmC7xM5NWxD4rfxUeUCzfK4H6lCgGmKG1l9hkppc="
  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "support@anthropic.com",
      "name": "Anthropic"
    },
    "description": "TypeScript/JavaScript language server for enhanced code intelligence",
    "extensions": {
      "com.anthropic.claude-code": {
        "lspServers": {
          "typescript": {
            "args": [
              "--stdio"
            ],
            "command": "typescript-language-server",
            "extensionToLanguage": {
              ".cjs": "javascript",
              ".cts": "typescript",
              ".js": "javascript",
              ".jsx": "javascriptreact",
              ".mjs": "javascript",
              ".mts": "typescript",
              ".ts": "typescript",
              ".tsx": "typescriptreact"
            }
          }
        }
      }
    },
    "name": "typescript-lsp",
    "version": "1.0.0"
  },
  "skills": {},
  "requiredRuntimes": [
    "typescript-language-server"
  ],
  "dependencies": [
    "pyright",
    "clang-tools",
    "jdt-language-server"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "meta": {
    "description": "TypeScript/JavaScript language server for enhanced code intelligence",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [
      "--dependency=pyright",
      "--dependency=clang-tools",
      "--dependency=jdt-language-server",
      "--path-ignore=external_plugins/context7",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".claude-plugin/marketplace.json",
        "message": "entry \"typescript-lsp\": lspServers does not apply beside plugins/typescript-lsp/.claude-plugin/plugin.json, which Claude Code reads instead, not imported"
      },
      {
        "path": "plugins/typescript-lsp/.claude-plugin/plugin.json/lspServers/typescript",
        "message": "Claude Code starts this language server for .cjs, .cts, .js, .jsx, .mjs, .mts, .ts, .tsx files: typescript-language-server --stdio"
      }
    ]
  }
}
