{
  "name": "foundry-iq-skills",
  "version": "0.3.2",
  "src": {
    "owner": "microsoft",
    "repo": "skills",
    "rev": "0d60658e34d07c05a5cd0514d3e64ccd653e8539",
    "hash": "sha256-K75/Wh8SWVtBFgsS32hsTqSWu9ksOY+GJv3fvoph/gM="
  },
  "sourceUrl": "https://github.com/microsoft/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Microsoft",
      "url": "https://www.microsoft.com"
    },
    "description": "Diagnose Foundry IQ and Azure AI Search access and ingestion issues, and configure Azure AI Search and Foundry IQ with source-aware security and verified API guidance. Build and query entity graphs, topic graphs and ontologies over your documents.",
    "homepage": "https://github.com/microsoft/github-copilot-for-azure",
    "keywords": [
      "azure",
      "azure-ai-search",
      "foundry-iq",
      "search",
      "retrieval",
      "rag",
      "knowledge-graph",
      "entity",
      "grounding",
      "topic-graph",
      "ontology",
      "entity-graph",
      "graphrag",
      "owl",
      "ontology-validation"
    ],
    "license": "MIT",
    "name": "foundry-iq-skills",
    "repository": "https://github.com/microsoft/GitHub-Copilot-for-Azure",
    "version": "0.3.2"
  },
  "skills": {
    "foundry-iq": ".github/plugins/foundry-iq-skills/skills/foundry-iq"
  },
  "requiredRuntimes": [
    "bash",
    "node",
    "npx"
  ],
  "dependencies": [
    "powershell"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": ".github/plugins/foundry-iq-skills/hooks",
    "graph": ".github/plugins/foundry-iq-skills/graph"
  },
  "mcpServers": {
    "azure": {
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "foundry-iq-graph": {
      "args": [
        "${PLUGIN_ROOT}/graph/runtime/launch-python.mjs",
        "run",
        "entity",
        "foundry-iq-graph"
      ],
      "command": "node",
      "type": "stdio"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Diagnose Foundry IQ and Azure AI Search access and ingestion issues",
    "homepage": "https://github.com/microsoft/skills"
  },
  "import": {
    "input": "microsoft/skills",
    "flags": [
      "--dependency=powershell",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".github/skills",
        "message": "13 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": ".github/plugins/foundry-iq-skills/hooks/claude-hooks.json",
        "message": "Claude Code runs this on PostToolUse: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code"
      },
      {
        "path": ".github/plugins/foundry-iq-skills/hooks/claude-hooks.json",
        "message": "Claude Code runs this on SessionStart: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code"
      },
      {
        "path": ".github/plugins/foundry-iq-skills/graph/runtime/manifest.json",
        "message": "larger than 1MiB, so it was not read; a ${PLUGIN_ROOT} reference inside it ships nothing, and a script only it runs is not reported"
      },
      {
        "path": "com.anthropic.claude-code/hooks/scripts/pluginPathAllowPattern.sh",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "graph/apps-host/supervise.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "graph/runtime/bootstrap.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "graph/runtime/preflight.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "skills/foundry-iq/scripts/request_attribution.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      }
    ]
  }
}
