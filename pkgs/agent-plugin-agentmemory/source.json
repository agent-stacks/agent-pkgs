  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Rohit Ghumare",
      "url": "https://github.com/rohitg00"
    },
    "description": "Persistent memory for AI coding agents -- captures tool usage, compresses via LLM, injects context into future sessions",
    "homepage": "https://github.com/rohitg00/agentmemory",
    "license": "Apache-2.0",
    "name": "agentmemory",
    "repository": "https://github.com/rohitg00/agentmemory",
    "version": "0.9.30"
  },
  "skills": {
    "agentmemory-agents": "plugin/skills/agentmemory-agents",
    "agentmemory-architecture": "plugin/skills/agentmemory-architecture",
    "agentmemory-config": "plugin/skills/agentmemory-config",
    "agentmemory-hooks": "plugin/skills/agentmemory-hooks",
    "agentmemory-mcp-tools": "plugin/skills/agentmemory-mcp-tools",
    "agentmemory-rest-api": "plugin/skills/agentmemory-rest-api",
    "commit-context": "plugin/skills/commit-context",
    "commit-history": "plugin/skills/commit-history",
    "forget": "plugin/skills/forget",
    "handoff": "plugin/skills/handoff",
    "lesson": "plugin/skills/lesson",
    "memory-discipline": "plugin/skills/memory-discipline",
    "recall": "plugin/skills/recall",
    "recap": "plugin/skills/recap",
    "remember": "plugin/skills/remember",
    "session-history": "plugin/skills/session-history",
    "write-agentmemory-skill": "plugin/skills/write-agentmemory-skill"
  },
  "requiredRuntimes": [
    "node"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "plugin/hooks",
    "scripts": "plugin/scripts"
  },
  "mcpServers": {
    "agentmemory": {
      "args": [
        "${PLUGIN_ROOT}/scripts/plugin-bridge.mjs"
      ],
      "command": "node",
      "type": "stdio"
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/notification.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-use.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-failure.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-compact.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-tool-use.mjs\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Read|Glob|Grep"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-start.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-stop.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/task-completed.mjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/prompt-submit.mjs\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Persistent memory for AI coding agents",
    "homepage": "https://github.com/rohitg00/agentmemory"
  },
