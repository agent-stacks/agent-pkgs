{
  "name": "review-agent-governance",
  "version": "0.1.5",
  "src": {
    "owner": "wshobson",
    "repo": "agents",
    "rev": "9924f719b2ddbbf5326459e55b8720bad8f693c6",
    "hash": "sha256-O7DtOdJ8uIZAoM/glkq4TyCKC8nmxq4GgRUTsvwGd00="
  },
  "sourceUrl": "https://github.com/wshobson/agents",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "tommy@scopeblind.com",
      "name": "Tom Farley",
      "url": "https://github.com/tomjwxf"
    },
    "description": "Require a human approval signal before an AI agent can post PR reviews, comments, merges, or writes to CI configuration. Joins protect-mcp and signed-audit-trails in the governance category; composes with protect-mcp for runtime enforcement.",
    "homepage": "https://veritasacta.com",
    "keywords": [
      "review",
      "governance",
      "cedar",
      "receipts",
      "human-approval",
      "pr-review",
      "ci-guard"
    ],
    "license": "MIT",
    "name": "review-agent-governance",
    "version": "0.1.5"
  },
  "skills": {
    "review-agent-setup": "plugins/review-agent-governance/skills/review-agent-setup"
  },
  "requiredRuntimes": [
    "bash"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/agents": "plugins/review-agent-governance/agents",
    "com.anthropic.claude-code/commands": "plugins/review-agent-governance/commands",
    "com.anthropic.claude-code/hooks": "plugins/review-agent-governance/hooks"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/sign.sh",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/evaluate.sh",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  },
  "meta": {
    "description": "Require a human approval signal before an AI agent can post PR reviews, comments, merges, or writes to CI configuration",
    "homepage": "https://github.com/wshobson/agents"
  },
  "import": {
    "input": "wshobson/agents",
    "flags": [
      "--path-ignore=plugins/avoid-ai-writing"
    ],
    "warnings": [
      {
        "path": "plugins/review-agent-governance/hooks/hooks.json",
        "message": "Claude Code runs this on PostToolUse: \"${CLAUDE_PLUGIN_ROOT}\"/hooks/sign.sh"
      },
      {
        "path": "plugins/review-agent-governance/hooks/hooks.json",
        "message": "Claude Code runs this on PreToolUse: \"${CLAUDE_PLUGIN_ROOT}\"/hooks/evaluate.sh"
      }
    ]
  }
}
