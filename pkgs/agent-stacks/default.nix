# Generated by agent-stacks 0.9.0-318-gbb51dcb (bb51dcbf3dd027bbbd8d582dbbcb89f58bf49248); rewritten on every import.
# The agent-stacks binary that ran `agent-stacks import`, fetched as
# published rather than built from source, so the binary that imported
# a package is the binary that builds it.
#
# default.json beside this file is that binary's hashes.json from
# downloads.agent-stacks.org, copied byte for byte. Import rewrites
# both files on every run; its source is internal/importer/nixlib in
# agent-stacks-cli.
#
# With a `skillspector` in scope (a sibling package, or one the flake
# passes), the package is the binary wrapped with skillspector on its
# PATH, so `agent-stacks audit` can score. Without one it is the bare
# binary. passthru.unwrapped is always the bare binary, which is what
# buildAgentPlugin runs: a plugin build never audits (agent-pkgs ADR
# 0020).
{
  lib,
  stdenvNoCC,
  fetchurl,
  makeBinaryWrapper,
  skillspector ? null,
}:

let
  source = builtins.fromJSON (builtins.readFile ./default.json);

  # What VERSION reads in the commit, which the binary reports. The
  # package is published as `version`, the git describe string.
  inherit (source) baseVersion version;

  system = stdenvNoCC.hostPlatform.system;

  binary =
    source.binaries.${system}
      or (throw "agent-stacks: no binary published for ${system}; see meta.platforms");

  meta = {
    description = "CLI for building, checking, importing, and launching agent plugins";
    homepage = "https://downloads.agent-stacks.org/";
    license = lib.licenses.unfree;
    mainProgram = "agent-stacks";
    platforms = lib.attrNames source.binaries;
    # The CLI itself: not an agent, and not a plugin. ADR 0014.
    category = "agent-tool";
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
  };

  # The binary as published. The pname keeps the -bin suffix, which is
  # what agent-pkgs' unfree predicate matches on.
  unwrapped = stdenvNoCC.mkDerivation {
    pname = "agent-stacks-bin";
    inherit version meta;

    # Uploaded by agent-stacks-cli's CI, never rewritten, so the hash
    # stays valid for as long as the object exists.
    src = fetchurl {
      inherit (binary) url hash;
    };

    # A bare executable, not an archive.
    dontUnpack = true;

    installPhase = ''
      runHook preInstall
      install -Dm755 "$src" "$out/bin/agent-stacks"
      runHook postInstall
    '';

    # Proves the fetched binary runs here and reports the version its
    # commit claims. Skipped when the binary cannot run on the build
    # machine.
    doInstallCheck = stdenvNoCC.hostPlatform.canExecute stdenvNoCC.hostPlatform;
    installCheckPhase = ''
      runHook preInstallCheck
      got="$("$out/bin/agent-stacks" --version)"
      if [ "$got" != "${baseVersion}" ]; then
        echo "agent-stacks --version reported '$got', expected '${baseVersion}'" >&2
        exit 1
      fi
      runHook postInstallCheck
    '';

    passthru = { inherit unwrapped; };
  };
in

if skillspector == null then
  unwrapped
else
  stdenvNoCC.mkDerivation {
    pname = "agent-stacks-bin";
    inherit version meta;

    dontUnpack = true;
    nativeBuildInputs = [ makeBinaryWrapper ];

    installPhase = ''
      runHook preInstall
      makeBinaryWrapper ${lib.getExe' unwrapped "agent-stacks"} "$out/bin/agent-stacks" \
        --prefix PATH : ${lib.makeBinPath [ skillspector ]}
      runHook postInstall
    '';

    passthru = { inherit unwrapped; };
  }
