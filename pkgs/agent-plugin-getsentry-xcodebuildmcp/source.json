  },
  "sourceUrl": "https://github.com/getsentry/XcodeBuildMCP",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "name": "getsentry-xcodebuildmcp"
  },
  "skills": {
    "mobilebuildmcp": "skills/mobilebuildmcp",
    "mobilebuildmcp-cli": "skills/mobilebuildmcp-cli",
    "mobilebuildmcp-docs-command-review": ".agents/skills/mobilebuildmcp-docs-command-review",
    "mobilebuildmcp-docs-release-review": ".agents/skills/mobilebuildmcp-docs-release-review",
    "mobilebuildmcp-packaging-resource-review": ".agents/skills/mobilebuildmcp-packaging-resource-review",
    "mobilebuildmcp-rendering-streaming-review": ".agents/skills/mobilebuildmcp-rendering-streaming-review",
    "mobilebuildmcp-runtime-boundary-review": ".agents/skills/mobilebuildmcp-runtime-boundary-review",
    "mobilebuildmcp-snapshot-fixture-review": ".agents/skills/mobilebuildmcp-snapshot-fixture-review",
    "mobilebuildmcp-structured-output-review": ".agents/skills/mobilebuildmcp-structured-output-review",
    "mobilebuildmcp-test-boundary-review": ".agents/skills/mobilebuildmcp-test-boundary-review",
    "mobilebuildmcp-tool-contract-review": ".agents/skills/mobilebuildmcp-tool-contract-review",
    "warden": ".agents/skills/warden",
    "warden-sweep": ".agents/skills/warden-sweep"
  },
  "requiredRuntimes": [
    "node",
    "python3"
  ],
  "mcpServers": {
    "mobilebuildmcp-dev": {
      "args": [
        "../../build/cli.js",
        "mcp"
      ],
      "command": "node",
      "env": {
        "MOBILEBUILDMCP_DEBUG": "true",
        "MOBILEBUILDMCP_IOS_TEMPLATE_PATH": "../../../XcodeBuildMCP-iOS-Template",
        "MOBILEBUILDMCP_MACOS_TEMPLATE_PATH": "../../../XcodeBuildMCP-macOS-Template",
        "MOBILEBUILDMCP_SENTRY_DISABLED": "true"
      },
      "type": "stdio"
    },
    "sentry": {
      "type": "streamable-http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  },
  "meta": {
    "description": "Agent plugin imported from https://github.com/getsentry/XcodeBuildMCP",
    "homepage": "https://github.com/getsentry/XcodeBuildMCP"
  },
  "import": {
    "input": "getsentry/XcodeBuildMCP",
    "flags": [],
    "warnings": [
      {
        "path": ".agents/skills/warden-sweep/SKILL.md",
        "message": "unknown frontmatter fields: disable-model-invocation"
      },
      {
        "path": "skills/warden-sweep/scripts/_utils.py",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      }
    ]
  }
}
