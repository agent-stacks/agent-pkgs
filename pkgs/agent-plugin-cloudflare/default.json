{
  "name": "cloudflare",
  "version": "1.0.4",
  "src": {
    "owner": "cloudflare",
    "repo": "skills",
    "rev": "ff191de7d903788eceaf516a514ae7d3b56b924a",
    "hash": "sha256-50afPPoq1/Xd+es0P6HOoL7U0b9oT9dxUpPgq4n3UUQ="
  },
  "sourceUrl": "https://github.com/cloudflare/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "support@cloudflare.com",
      "name": "Cloudflare",
      "url": "https://www.cloudflare.com/products/workers/"
    },
    "description": "Build, test, and deploy applications on Cloudflare with platform guidance Skills and the Cloudflare MCP server.",
    "extensions": {
      "com.openai": {
        "interface": {
          "brandColor": "#F6821F",
          "capabilities": [
            "Interactive",
            "Write"
          ],
          "category": "Developer Tools",
          "composerIcon": "./com.openai/logo.svg",
          "defaultPrompt": [
            "Build a Cloudflare Worker or agent with the right SDK and Wrangler setup",
            "Review this Cloudflare project for production Workers best practices",
            "Use Cloudflare skills and MCP to inspect or deploy this project"
          ],
          "developerName": "Cloudflare",
          "displayName": "Cloudflare",
          "logo": "./com.openai/logo.svg",
          "longDescription": "Build, review, and operate on Cloudflare with guidance for Workers, Durable Objects, Agents SDK, Cloudflare One, Wrangler, web performance, Turnstile, and more, plus the Cloudflare Code Mode MCP server for live account, API, and documentation workflows.",
          "privacyPolicyURL": "https://www.cloudflare.com/privacypolicy/",
          "screenshots": [],
          "shortDescription": "Cloudflare platform and MCP",
          "termsOfServiceURL": "https://www.cloudflare.com/website-terms/",
          "websiteURL": "https://developers.cloudflare.com/"
        },
        "mcpServers": "./com.openai/.mcp.json",
        "skills": "./skills/"
      }
    },
    "homepage": "https://developers.cloudflare.com/",
    "keywords": [
      "cloudflare",
      "workers",
      "durable-objects",
      "agents",
      "mcp",
      "wrangler",
      "serverless",
      "compute",
      "storage",
      "applications"
    ],
    "license": "Apache-2.0",
    "name": "cloudflare",
    "repository": "https://github.com/cloudflare/skills",
    "version": "1.0.4"
  },
  "skills": {
    "agents-sdk": "skills/agents-sdk",
    "artifacts": "skills/artifacts",
    "basin": "skills/basin",
    "cf-cli": "skills/cf-cli",
    "cloudflare": "skills/cloudflare",
    "cloudflare-app-bootstrap": "skills/cloudflare-app-bootstrap",
    "cloudflare-email-service": "skills/cloudflare-email-service",
    "cloudflare-one": "skills/cloudflare-one",
    "cloudflare-one-migrations": "skills/cloudflare-one-migrations",
    "durable-objects": "skills/durable-objects",
    "flagship": "skills/flagship",
    "frameworks-on-cloudflare": "skills/frameworks-on-cloudflare",
    "gateway-workers": "skills/gateway-workers",
    "k2": "skills/k2",
    "nextjs-on-cloudflare": "skills/nextjs-on-cloudflare",
    "sandbox-migrate-to-next": "skills/sandbox-migrate-to-next",
    "sandbox-next": "skills/sandbox-next",
    "sandbox-stable": "skills/sandbox-stable",
    "turnstile-spin": "skills/turnstile-spin",
    "web-perf": "skills/web-perf",
    "workers-best-practices": "skills/workers-best-practices",
    "workers-development": "skills/workers-development",
    "workers-profiling": "skills/workers-profiling",
    "wrangler": "skills/wrangler"
  },
  "requiredRuntimes": [
    "bash"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.openai/.mcp.json": ".mcp.json",
    "com.openai/logo.svg": "logo.svg"
  },
  "mcpServers": {
    "cloudflare": {
      "type": "streamable-http",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  },
  "meta": {
    "description": "Build, test, and deploy applications on Cloudflare with platform guidance Skills and the Cloudflare MCP server",
    "homepage": "https://github.com/cloudflare/skills"
  },
  "import": {
    "input": "cloudflare/skills",
    "flags": [
      "--pkgs-dir=pkgs"
    ]
  }
}
