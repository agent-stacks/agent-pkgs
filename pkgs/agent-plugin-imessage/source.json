  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "description": "iMessage messaging bridge with built-in access control. Reads chat.db directly, sends via AppleScript. Manage pairing, allowlists, and policy via /imessage:access.",
    "keywords": [
      "imessage",
      "messaging",
      "channel",
      "mcp"
    ],
    "name": "imessage",
    "version": "0.2.0"
  },
  "skills": {
    "access": "external_plugins/imessage/skills/access",
    "configure": "external_plugins/imessage/skills/configure"
  },
  "requiredRuntimes": [
    "bun"
  ],
  "pluginRootPaths": {
    "ACCESS.md": "external_plugins/imessage/ACCESS.md",
    "LICENSE": "external_plugins/imessage/LICENSE",
    "README.md": "external_plugins/imessage/README.md",
    "bun.lock": "external_plugins/imessage/bun.lock",
    "package.json": "external_plugins/imessage/package.json",
    "server.ts": "external_plugins/imessage/server.ts"
  },
  "mcpServers": {
    "imessage": {
      "args": [
        "run",
        "--cwd",
        "${PLUGIN_ROOT}",
        "--shell=bun",
        "--silent",
        "start"
      ],
      "command": "bun",
      "type": "stdio"
    }
  },
  "meta": {
    "description": "iMessage messaging bridge with built-in access control",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [],
    "warnings": [
      {
        "path": "external_plugins/imessage/skills/access/SKILL.md",
        "message": "unknown frontmatter fields: user-invocable"
      },
      {
        "path": "external_plugins/imessage/skills/access/SKILL.md/allowed-tools",
        "message": "must be a space-separated string, not a list (Read Write Bash(ls *) Bash(mkdir *))"
      },
      {
        "path": "external_plugins/imessage/skills/configure/SKILL.md",
        "message": "unknown frontmatter fields: user-invocable"
      },
      {
        "path": "external_plugins/imessage/skills/configure/SKILL.md/allowed-tools",
        "message": "must be a space-separated string, not a list (Read Bash(ls *))"
      },
      {
        "path": "external_plugins/imessage",
        "message": "a server declared in external_plugins/imessage/.mcp.json runs from the plugin root, so the root's files ship: ACCESS.md, LICENSE, README.md, bun.lock, package.json, server.ts"
      },
      {
        "path": "package.json",
        "message": "dependency manifest; the build does not resolve what it declares"
      }
    ]
