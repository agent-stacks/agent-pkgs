          "brandColor": "#76B900",
          "capabilities": [
            "Read",
            "Write",
            "Interactive"
          ],
          "category": "Developer Tools",
          "defaultPrompt": [
            "What can NVIDIA TAO do?",
            "Choose and run a TAO workflow for my dataset.",
            "List TAO models, actions, AutoML, and platforms."
          ],
          "developerName": "NVIDIA",
          "displayName": "NVIDIA TAO Toolkit",
          "longDescription": "Agent skills for NVIDIA TAO: fine-tune, evaluate, export, and deploy vision and multimodal models; prepare and generate training data; run AutoML and application workflows; and launch jobs on Docker, Kubernetes, SLURM, or Brev. The plugin exposes every skill under ./skills/. Capability answers are generated from the packaged skills by scripts/list_tao_capabilities.py rather than hard-coded in plugin metadata.",
          "shortDescription": "TAO workflows, models, AutoML"
        },
        "skills": "./skills/"
      }
    },
