# Superpowers working files: specs, plans, and the subagent-driven
# development workspace. They are scratch for the work in progress, not
# part of the package set. agent-stacks ignores the same paths.
docs/superpowers/
.superpowers/

# Nix build artifact.
/result

# Per-run staging directory written by `agent-stacks launch`, which lands
# in the working directory when a stack is run from inside the repo. It
# holds symlinks into a specific store path, so it is never committable.
.agent-stacks/
