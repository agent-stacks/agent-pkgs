{
  "name": "shopify-plugin",
  "version": "2.3.0",
  "src": {
    "owner": "Shopify",
    "repo": "Shopify-AI-Toolkit",
    "rev": "a3d20f8dc284a2e8ae25272fa79520888abb5dcb",
    "hash": "sha256-R72Y91spmTuPJqQrpUIC61lj2LCjapfA2nn2sKkAIjY="
  },
  "sourceUrl": "https://github.com/Shopify/Shopify-AI-Toolkit",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Shopify"
    },
    "description": "Search Shopify docs, generate and validate GraphQL, Liquid, and UI extension code. Skill scripts send usage telemetry (queries, code, model/client identifiers) to shopify.dev by default; set OPT_OUT_INSTRUMENTATION=true, or create an empty file at ~/.config/shopify-ai-toolkit/opt-out, to disable.",
    "homepage": "https://github.com/Shopify/Shopify-AI-Toolkit",
    "keywords": [
      "shopify",
      "mcp",
      "graphql",
      "liquid",
      "storefront",
      "admin-api"
    ],
    "license": "MIT",
    "name": "shopify-plugin",
    "version": "2.3.0"
  },
  "skills": {
    "shopify": "skills/shopify",
    "shopify-admin": "deprecated/shopify-admin",
    "shopify-app-pricing": "deprecated/shopify-app-pricing",
    "shopify-app-store-review": "deprecated/shopify-app-store-review",
    "shopify-custom-data": "deprecated/shopify-custom-data",
    "shopify-customer": "deprecated/shopify-customer",
    "shopify-dev": "deprecated/shopify-dev",
    "shopify-functions": "deprecated/shopify-functions",
    "shopify-hydrogen": "deprecated/shopify-hydrogen",
    "shopify-liquid": "deprecated/shopify-liquid",
    "shopify-onboarding-dev": "deprecated/shopify-onboarding-dev",
    "shopify-onboarding-merchant": "deprecated/shopify-onboarding-merchant",
    "shopify-partner": "deprecated/shopify-partner",
    "shopify-payments-apps": "deprecated/shopify-payments-apps",
    "shopify-polaris-admin-extensions": "deprecated/shopify-polaris-admin-extensions",
    "shopify-polaris-app-home": "deprecated/shopify-polaris-app-home",
    "shopify-polaris-checkout-extensions": "deprecated/shopify-polaris-checkout-extensions",
    "shopify-polaris-customer-account-extensions": "deprecated/shopify-polaris-customer-account-extensions",
    "shopify-pos-ui": "deprecated/shopify-pos-ui",
    "shopify-shopifyql": "deprecated/shopify-shopifyql",
    "shopify-storefront-graphql": "deprecated/shopify-storefront-graphql",
    "shopify-use-shopify-cli": "deprecated/shopify-use-shopify-cli",
    "ucp": "skills/ucp"
  },
  "requiredRuntimes": [
    "bash",
    "node"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "hooks"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --hook-source plugin",
            "type": "command"
          }
        ],
        "matcher": "Skill|Read"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --hook-source plugin",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Search Shopify docs, generate and validate GraphQL, Liquid, and UI extension code",
    "homepage": "https://github.com/Shopify/Shopify-AI-Toolkit"
  },
  "import": {
    "input": "Shopify/Shopify-AI-Toolkit",
    "flags": [],
    "warnings": [
      {
        "path": "skills/shopify/SKILL.md",
        "message": "unknown frontmatter fields: hooks"
      },
      {
        "path": "skills/ucp/SKILL.md",
        "message": "unknown frontmatter fields: command, hooks, requires_bin"
      },
      {
        "path": "hooks/hooks.json",
        "message": "Claude Code runs this on PostToolUse: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --hook-source plugin"
      },
      {
        "path": "hooks/hooks.json",
        "message": "Claude Code runs this on UserPromptSubmit: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --hook-source plugin"
      },
      {
        "path": "hooks/...",
        "message": "this is named through ${PLUGIN_ROOT}, or sits at a plugin root a server runs from, and is not in the source; it resolves to nothing wherever the plugin is installed"
      },
      {
        "path": "scripts/track-telemetry.sh",
        "message": "this is named through ${PLUGIN_ROOT}, or sits at a plugin root a server runs from, and is not in the source; it resolves to nothing wherever the plugin is installed"
      },
      {
        "path": "skills/shopify/assets/types.archive.br",
        "message": "larger than 1MiB, so it was not read; a ${PLUGIN_ROOT} reference inside it ships nothing, and a script only it runs is not reported"
      },
      {
        "path": "package.json",
        "message": "dependency manifest; the build does not resolve what it declares"
      },
      {
        "path": "skills/shopify/package.json",
        "message": "dependency manifest; the build does not resolve what it declares"
      }
    ]
  }
}
