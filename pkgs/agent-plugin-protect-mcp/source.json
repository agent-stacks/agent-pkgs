{
  "name": "protect-mcp",
  "version": "0.1.5",
  "src": {
    "owner": "wshobson",
    "repo": "agents",
    "rev": "00da14c841988675273285e7b0223a344e601e0d",
    "hash": "sha256-uD4kv3Nm4tt4ulPwfre4ekP5+VGPgSz6HN5fUfpI4m8="
  },
  "sourceUrl": "https://github.com/wshobson/agents",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "tommy@scopeblind.com",
      "name": "Tom Farley",
      "url": "https://github.com/tomjwxf"
    },
    "description": "Cedar policy enforcement + Ed25519 signed receipts for every Claude Code tool call. First cryptographic governance plugin — decisions are policy-gated before they run and every decision produces a tamper-evident receipt verifiable offline.",
    "homepage": "https://veritasacta.com",
    "keywords": [
      "cedar",
      "receipts",
      "ed25519",
      "policy",
      "governance",
      "audit",
      "compliance"
    ],
    "license": "MIT",
    "name": "protect-mcp",
    "version": "0.1.5"
  },
  "skills": {
    "protect-mcp-setup": "plugins/protect-mcp/skills/protect-mcp-setup"
  },
  "requiredRuntimes": [
    "bash"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/agents": "plugins/protect-mcp/agents",
    "com.anthropic.claude-code/commands": "plugins/protect-mcp/commands",
    "com.anthropic.claude-code/hooks": "plugins/protect-mcp/hooks"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/sign.sh",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/evaluate.sh",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  },
  "meta": {
    "description": "Cedar policy enforcement + Ed25519 signed receipts for every Claude Code tool call",
    "homepage": "https://github.com/wshobson/agents"
  },
  "import": {
    "input": "wshobson/agents",
    "flags": [
      "--path-ignore=plugins/avoid-ai-writing"
    ],
    "warnings": [
      {
        "path": "plugins/protect-mcp/hooks/hooks.json",
        "message": "Claude Code runs this on PostToolUse: \"${CLAUDE_PLUGIN_ROOT}\"/hooks/sign.sh"
      },
      {
        "path": "plugins/protect-mcp/hooks/hooks.json",
        "message": "Claude Code runs this on PreToolUse: \"${CLAUDE_PLUGIN_ROOT}\"/hooks/evaluate.sh"
      }
    ]
  }
}
