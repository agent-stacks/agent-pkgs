  },
  "sourceUrl": "https://github.com/microsoft/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "thegovind",
      "url": "https://github.com/thegovind"
    },
    "description": "AI-powered wiki generator for code repositories. Generates comprehensive, Mermaid-rich structured documentation with architecture diagrams, component analysis, and source citations.",
    "extensions": {
      "com.anthropic.claude-code": {
        "agents": [
          "./agents/wiki-architect.md",
          "./agents/wiki-researcher.md",
          "./agents/wiki-writer.md"
        ],
        "commands": [
          "./commands/"
        ]
      }
    },
    "homepage": "https://github.com/microsoft/skills/tree/main/.github/plugins/deep-wiki",
    "keywords": [
      "wiki",
      "documentation",
      "mermaid",
      "architecture",
      "code-analysis"
    ],
    "license": "MIT",
    "name": "deep-wiki",
    "repository": "https://github.com/microsoft/skills",
    "version": "1.0.0"
  },
  "skills": {
    "wiki-ado-convert": ".github/plugins/deep-wiki/skills/wiki-ado-convert",
    "wiki-agents-md": ".github/plugins/deep-wiki/skills/wiki-agents-md",
    "wiki-architect": ".github/plugins/deep-wiki/skills/wiki-architect",
    "wiki-changelog": ".github/plugins/deep-wiki/skills/wiki-changelog",
    "wiki-llms-txt": ".github/plugins/deep-wiki/skills/wiki-llms-txt",
    "wiki-onboarding": ".github/plugins/deep-wiki/skills/wiki-onboarding",
    "wiki-page-writer": ".github/plugins/deep-wiki/skills/wiki-page-writer",
    "wiki-qa": ".github/plugins/deep-wiki/skills/wiki-qa",
    "wiki-researcher": ".github/plugins/deep-wiki/skills/wiki-researcher",
    "wiki-vitepress": ".github/plugins/deep-wiki/skills/wiki-vitepress"
  },
  "requiredRuntimes": [],
  "dependencies": [
    "powershell"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/agents": ".github/plugins/deep-wiki/agents",
    "com.anthropic.claude-code/commands": ".github/plugins/deep-wiki/commands"
  },
  "meta": {
    "description": "AI-powered wiki generator for code repositories",
    "homepage": "https://github.com/microsoft/skills"
  },
  "import": {
    "input": "microsoft/skills",
    "flags": [
      "--dependency=powershell"
    ],
    "warnings": [
      {
        "path": ".github/skills",
        "message": "13 SKILL.md outside every imported plugin, not imported"
      }
    ]
  }
