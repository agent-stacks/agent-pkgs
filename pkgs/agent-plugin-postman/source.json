{
  "name": "postman",
  "version": "2.1.0",
  "src": {
    "owner": "postmanlabs",
    "repo": "postman-plugin",
    "rev": "e77238cb8eb46674b83c5d34d97451f6a46ac594",
    "hash": "sha256-y8Do3gXp7hmDfQOenUyjtHg7ABsVkRT3S0xeUKiMSzw="
  },
  "sourceUrl": "https://github.com/postmanlabs/postman-plugin",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "postman-plugins@postman.com",
      "name": "Postman",
      "url": "https://github.com/postmanlabs"
    },
    "description": "Work with Postman from your agent: bootstrap a repo's Postman setup, mock an API before it's implemented, run collection and governance checks in CI, monitor a live endpoint, deploy and debug Postman Flows, and publish generated API documentation.",
    "homepage": "https://github.com/postmanlabs/postman-plugin",
    "keywords": [
      "postman",
      "api",
      "mocking",
      "monitoring",
      "ci",
      "documentation",
      "ai-readiness",
      "flows"
    ],
    "license": "Apache-2.0",
    "name": "postman",
    "repository": "https://github.com/postmanlabs/postman-plugin",
    "version": "2.1.0"
  },
  "skills": {
    "ai-readiness": "skills/ai-readiness",
    "api-discovery": "skills/api-discovery",
    "api-documentation": "skills/api-documentation",
    "api-engineer": "skills/api-engineer",
    "api-mocking": "skills/api-mocking",
    "api-monitoring": "skills/api-monitoring",
    "api-simulation": "skills/api-simulation",
    "api-testing": "skills/api-testing",
    "application-testing": "skills/application-testing",
    "bootstrap": "skills/bootstrap",
    "ci-integration": "skills/ci-integration",
    "collection-schema-v3": "skills/collection-schema-v3",
    "datasets": "skills/datasets",
    "flows": "skills/flows",
    "performance-testing": "skills/performance-testing",
    "postman-mcp-server": "skills/postman-mcp-server",
    "variables": "skills/variables",
    "webhook-testing": "skills/webhook-testing"
  },
  "requiredRuntimes": [
    "sh"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "hooks"
  },
  "mcpServers": {
    "postman": {
      "headers": {
        "User-Agent": "postman-claude-code-plugin/2.1.0",
        "X-Plugin-Version": "2.1.0",
        "X-Source": "postman-claude-code-plugin"
      },
      "type": "streamable-http",
      "url": "https://mcp.postman.com/mcp"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "async": false,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start\" \"${DROID_PLUGIN_ROOT}\"",
            "shell": "bash",
            "type": "command"
          }
        ],
        "matcher": "startup|clear|compact"
      }
    ]
  },
  "meta": {
    "description": "Work with Postman from your agent",
    "homepage": "https://github.com/postmanlabs/postman-plugin"
  },
  "import": {
    "input": "postmanlabs/postman-plugin",
    "flags": [
      "--path-ignore=.claude/skills"
    ],
    "warnings": [
      {
        "path": "hooks/hooks.json",
        "message": "Claude Code runs this on SessionStart: \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start\" \"${DROID_PLUGIN_ROOT}\""
      },
      {
        "path": "package.json",
        "message": "dependency manifest; the build does not resolve what it declares"
      }
    ]
  }
}
