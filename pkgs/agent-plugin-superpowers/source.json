  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "hooks"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "async": false,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "shell": "bash",
            "type": "command"
          }
        ],
        "matcher": "startup|clear|compact"
      }
    ]
  },
  "meta": {
    "description": "Core skills library for Claude Code",
    "homepage": "https://github.com/obra/superpowers"
  },
  "import": {
    "input": "obra/superpowers",
    "flags": [],
    "warnings": [
      {
        "path": "hooks/hooks.json",
        "message": "Claude Code runs this on SessionStart: \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start"
      },
      {
        "path": "package.json",
        "message": "dependency manifest; the build does not resolve what it declares"
      }
    ]
  }
