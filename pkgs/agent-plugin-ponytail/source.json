{
  "name": "ponytail",
  "version": "5.2.0",
  "src": {
    "owner": "DietrichGebert",
    "repo": "ponytail",
    "rev": "2961b52fc1fe6a5a87c7a959a79512e5c2f3ffe5",
    "hash": "sha256-3GopEvTySUvo0ghGz4CF6xbN7x3kbB/IHEY7Dwr4dls="
  },
  "sourceUrl": "https://github.com/DietrichGebert/ponytail",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Dietrich Gebert",
      "url": "https://github.com/DietrichGebert"
    },
    "description": "Forces the laziest solution that works. YAGNI, stdlib first, one line over fifty.",
    "name": "ponytail",
    "version": "5.2.0"
  },
  "skills": {
    "ponytail": ".openclaw/skills/ponytail",
    "ponytail-audit": ".openclaw/skills/ponytail-audit",
    "ponytail-debt": ".openclaw/skills/ponytail-debt",
    "ponytail-gain": ".openclaw/skills/ponytail-gain",
    "ponytail-help": ".openclaw/skills/ponytail-help",
    "ponytail-review": ".openclaw/skills/ponytail-review"
  },
  "requiredRuntimes": [
    "bash",
    "node"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "hooks"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-activate.js'))\"",
            "statusMessage": "Loading ponytail mode...",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-subagent.js'))\"",
            "statusMessage": "Loading ponytail mode...",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-mode-tracker.js'))\"",
            "statusMessage": "Tracking ponytail mode...",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Forces the laziest solution that works",
    "homepage": "https://github.com/DietrichGebert/ponytail"
  },
  "import": {
    "input": "DietrichGebert/ponytail",
    "flags": [],
    "warnings": [
      {
        "path": ".openclaw/skills/ponytail-audit/SKILL.md",
        "message": "unknown frontmatter fields: homepage"
      },
      {
        "path": ".openclaw/skills/ponytail-debt/SKILL.md",
        "message": "unknown frontmatter fields: homepage"
      },
      {
        "path": ".openclaw/skills/ponytail-gain/SKILL.md",
        "message": "unknown frontmatter fields: homepage"
      },
      {
        "path": ".openclaw/skills/ponytail-help/SKILL.md",
        "message": "unknown frontmatter fields: homepage"
      },
      {
        "path": ".openclaw/skills/ponytail-review/SKILL.md",
        "message": "unknown frontmatter fields: homepage"
      },
      {
        "path": ".openclaw/skills/ponytail/SKILL.md",
        "message": "unknown frontmatter fields: homepage"
      },
      {
        "path": "hooks/claude-codex-hooks.json",
        "message": "Claude Code runs this on SessionStart: node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-activate.js'))\""
      },
      {
        "path": "hooks/claude-codex-hooks.json",
        "message": "Claude Code runs this on SubagentStart: node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-subagent.js'))\""
      },
      {
        "path": "hooks/claude-codex-hooks.json",
        "message": "Claude Code runs this on UserPromptSubmit: node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-mode-tracker.js'))\""
      },
