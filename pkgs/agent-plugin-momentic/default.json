{
  "name": "momentic",
  "version": "1.3.0",
  "src": {
    "owner": "momentic-ai",
    "repo": "skills",
    "rev": "13ed440313ed5e3b57a4a8fa055af7c311bd14a4",
    "hash": "sha256-GaFXWa1J2GZFmHjgwNGdqzl14MN1O7nRlsPnTrDqeTo="
  },
  "sourceUrl": "https://github.com/momentic-ai/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "support@momentic.ai",
      "name": "Momentic"
    },
    "description": "Bug bash with Mo and write, run and maintain Momentic browser and mobile tests.",
    "homepage": "https://momentic.ai/developers",
    "keywords": [
      "momentic",
      "mo",
      "bug-bash",
      "testing",
      "e2e",
      "browser",
      "android",
      "ios",
      "automation",
      "skills",
      "mcp"
    ],
    "name": "momentic",
    "repository": "https://github.com/momentic-ai/skills",
    "version": "1.3.0"
  },
  "skills": {
    "mo-qa": "skills/mo-qa",
    "momentic-maintain": "skills/momentic-maintain",
    "momentic-spec": "skills/momentic-spec",
    "momentic-test": "skills/momentic-test"
  },
  "requiredRuntimes": [
    "node"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "local-mcp.cjs": "local-mcp.cjs"
  },
  "mcpServers": {
    "momentic": {
      "args": [
        "${PLUGIN_ROOT}/local-mcp.cjs",
        "momentic@3.73.0"
      ],
      "command": "node",
      "env": {
        "MOMENTIC_PLUGIN_API_KEY": "${user_config.MOMENTIC_API_KEY}"
      },
      "type": "stdio"
    },
    "momentic-hosted": {
      "type": "streamable-http",
      "url": "https://mcp.momentic.ai"
    },
    "momentic-mobile": {
      "args": [
        "${PLUGIN_ROOT}/local-mcp.cjs",
        "momentic-mobile@1.46.0"
      ],
      "command": "node",
      "env": {
        "MOMENTIC_PLUGIN_API_KEY": "${user_config.MOMENTIC_API_KEY}"
      },
      "type": "stdio"
    }
  },
  "meta": {
    "description": "Bug bash with Mo and write, run and maintain Momentic browser and mobile tests",
    "homepage": "https://github.com/momentic-ai/skills"
  },
  "import": {
    "input": "momentic-ai/skills",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "claude/skills/mo-qa",
        "message": "skill \"mo-qa\" already found at skills/mo-qa, not imported"
      }
    ]
  }
}
