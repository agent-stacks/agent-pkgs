{
  "name": "mongodb-atlas",
  "version": "1.2.1",
  "src": {
    "owner": "mongodb",
    "repo": "agent-skills",
    "rev": "7b44a4a06a8ac94f9911d7c94f3f7dc4a13d2d0a",
    "hash": "sha256-W8FJ0HKuyIZTyo2D7VsZkrhqAzY5jo4s7SKrafL4X38="
  },
  "sourceUrl": "https://github.com/mongodb/agent-skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "agent-plugins@mongodb.com",
      "name": "MongoDB",
      "url": "https://www.mongodb.com"
    },
    "description": "Connect to MongoDB Atlas clusters only through the Atlas Managed MCP Server. Sign in with your Atlas account to explore data, manage collections, optimize queries, generate reliable code with MongoDB best practices, and manage Atlas resources such as clusters, projects, database users, and network access.\n\nIf you are running a different MongoDB deployment or want to run a local MongoDB MCP Server, install the MongoDB (Self-Managed MCP) plugin instead.",
    "extensions": {
      "com.anthropic.claude-code": {
        "mcpServerFields": {
          "mongodb-atlas": {
            "oauth": {
              "clientId": "https://claude.ai/oauth/claude-code-client-metadata"
            }
          }
        }
      }
    },
    "homepage": "https://www.mongodb.com/docs/mcp-server/get-started/",
    "keywords": [
      "mongodb",
      "atlas",
      "database",
      "mcp",
      "vector-search"
    ],
    "license": "Apache-2.0",
    "name": "mongodb-atlas",
    "repository": "https://github.com/mongodb/agent-skills",
    "version": "1.2.1"
  },
  "skills": {
    "mongodb-atlas-stream-processing": "plugins/mongodb-atlas/skills/mongodb-atlas-stream-processing",
    "mongodb-connection": "plugins/mongodb-atlas/skills/mongodb-connection",
    "mongodb-natural-language-querying": "plugins/mongodb-atlas/skills/mongodb-natural-language-querying",
    "mongodb-qe-size-estimation": "plugins/mongodb-atlas/skills/mongodb-qe-size-estimation",
    "mongodb-query-optimizer": "plugins/mongodb-atlas/skills/mongodb-query-optimizer",
    "mongodb-schema-design": "plugins/mongodb-atlas/skills/mongodb-schema-design",
    "mongodb-search-and-ai": "plugins/mongodb-atlas/skills/mongodb-search-and-ai"
  },
  "requiredRuntimes": [
    "python3"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "mcpServers": {
    "mongodb-atlas": {
      "type": "streamable-http",
      "url": "https://mcp.mongodb.com/"
    }
  },
  "meta": {
    "description": "Connect to MongoDB Atlas clusters only through the Atlas Managed MCP Server",
    "homepage": "https://github.com/mongodb/agent-skills"
  },
  "import": {
    "input": "mongodb/agent-skills",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "plugins/mongodb-atlas/.claude-plugin/plugin.json/mcpServers/mongodb-atlas",
        "message": "Claude Code reads oauth here; carried in the manifest's extensions block, since mcp.json cannot hold them"
      },
      {
        "path": "skills",
        "message": "8 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": "tools/review-skill/SKILL.md",
        "message": "outside every imported plugin, not imported; --plugin tools/review-skill=NAME imports it"
      }
    ]
  }
}
