{
  "name": "chrome-devtools",
  "version": "1.13.0",
  "src": {
    "owner": "ChromeDevTools",
    "repo": "chrome-devtools-mcp",
    "rev": "8b7fa71d8ac8957754580028a2078b4181b59af1",
    "hash": "sha256-6gL/rpl7VnliMhc0YRzYKG+oIHmi+kxt5tFSRwlL+YQ="
  },
  "sourceUrl": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Google Chrome",
      "url": "https://developer.chrome.com/"
    },
    "description": "Reliable Chrome automation, debugging, and performance analysis for AI agents.",
    "homepage": "https://developer.chrome.com/docs/devtools/agents",
    "keywords": [
      "browser",
      "chrome",
      "debugging",
      "mcp",
      "performance"
    ],
    "license": "Apache-2.0",
    "name": "chrome-devtools",
    "repository": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
    "version": "1.13.0"
  },
  "skills": {
    "a11y-debugging": "skills/a11y-debugging",
    "chrome-devtools": "skills/chrome-devtools",
    "chrome-devtools-cli": "skills/chrome-devtools-cli",
    "cookie-debugging": "skills/cookie-debugging",
    "debug-optimize-lcp": "skills/debug-optimize-lcp",
    "inspect-in-devtools": "skills/inspect-in-devtools",
    "memory-leak-debugging": "skills/memory-leak-debugging",
    "troubleshooting": "skills/troubleshooting"
  },
  "requiredRuntimes": [
    "npx"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "--prefix",
        "${PLUGIN_DATA}",
        "chrome-devtools-mcp@1.13.0"
      ],
      "command": "npx",
      "type": "stdio"
    }
  },
  "meta": {
    "description": "Reliable Chrome automation, debugging, and performance analysis for AI agents",
    "homepage": "https://github.com/ChromeDevTools/chrome-devtools-mcp"
  },
  "import": {
    "input": "ChromeDevTools/chrome-devtools-mcp",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".claude-plugin/plugin.json",
        "message": "commands is a list, not a path or a list of paths; dropped"
      }
    ]
  }
}
