{
  "name": "swift-lsp",
  "version": "1.0.0",
  "src": {
    "owner": "anthropics",
    "repo": "claude-plugins-official",
    "rev": "a1ecfbc7f138a0ef455088f7f28cda2d22a0f853",
    "hash": "sha256-VK1686RhAiefN5Mv1FoNE3i1pRs5Ne38z8Hh3j5o4ng="
  },
  "sourceUrl": "https://github.com/anthropics/claude-plugins-official",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "support@anthropic.com",
      "name": "Anthropic"
    },
    "description": "Swift language server (SourceKit-LSP) for code intelligence",
    "extensions": {
      "com.anthropic.claude-code": {
        "lspServers": {
          "sourcekit-lsp": {
            "command": "sourcekit-lsp",
            "extensionToLanguage": {
              ".swift": "swift"
            }
          }
        }
      }
    },
    "name": "swift-lsp",
    "version": "1.0.0"
  },
  "skills": {},
  "requiredRuntimes": [
    "sourcekit-lsp"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "meta": {
    "description": "Swift language server (SourceKit-LSP) for code intelligence",
    "homepage": "https://github.com/anthropics/claude-plugins-official"
  },
  "import": {
    "input": "anthropics/claude-plugins-official",
    "flags": [
      "--path-ignore=external_plugins/context7",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".claude-plugin/marketplace.json",
        "message": "entry \"swift-lsp\": lspServers does not apply beside plugins/swift-lsp/.claude-plugin/plugin.json, which Claude Code reads instead, not imported"
      },
      {
        "path": "plugins/swift-lsp/.claude-plugin/plugin.json/lspServers/sourcekit-lsp",
        "message": "Claude Code starts this language server for .swift files: sourcekit-lsp"
      }
    ]
  }
}
