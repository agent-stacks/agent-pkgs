    "competitor-analysis": "plugins/openseo/skills/competitor-analysis",
    "keyword-clustering": "plugins/openseo/skills/keyword-clustering",
    "keyword-research": "plugins/openseo/skills/keyword-research",
    "link-prospecting": "plugins/openseo/skills/link-prospecting",
