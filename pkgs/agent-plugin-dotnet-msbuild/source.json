    "msbuild-modernization": "plugins/dotnet-msbuild/skills/msbuild-modernization",
    "property-patterns": "plugins/dotnet-msbuild/skills/property-patterns",
    "resolve-project-references": "plugins/dotnet-msbuild/skills/resolve-project-references",
    "target-authoring": "plugins/dotnet-msbuild/skills/target-authoring",
    "troubleshoot-binlog-mcp": "plugins/dotnet-msbuild/skills/troubleshoot-binlog-mcp"
