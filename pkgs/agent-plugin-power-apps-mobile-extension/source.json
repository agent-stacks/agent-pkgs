    "generate-ppmplugin": "plugins/power-apps-mobile-extension/skills/generate-ppmplugin",
    "generate-ppmplugin-manifest": "plugins/power-apps-mobile-extension/skills/generate-ppmplugin-manifest",
    "publish-pcf-companion": "plugins/power-apps-mobile-extension/skills/publish-pcf-companion",
    "telemetry": "plugins/power-apps-mobile-extension/skills/telemetry",
    "test-native-extension": "plugins/power-apps-mobile-extension/skills/test-native-extension"
  },
  "requiredRuntimes": [],
  "dependencies": [
    "dotnet-sdk_10"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "plugins/power-apps-mobile-extension/hooks"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node -e \"const path=require('node:path');const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;if(!root)process.exit(0);try{require(path.resolve(root,'hooks','run-telemetry.js')).start('pretool');}catch{}\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Skill|skill"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node -e \"const path=require('node:path');const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;if(!root)process.exit(0);try{require(path.resolve(root,'hooks','run-telemetry.js')).start('prompt');}catch{}\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Build third-party Power Apps Mobile (PAM) controls into a prebuilt .ppmplugin binary (Android DEX + flat iOS .framework + manifest.json) for the wrap runtime",
    "homepage": "https://github.com/microsoft/power-platform-skills"
  },
