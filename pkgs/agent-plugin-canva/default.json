  },
  "sourceUrl": "https://github.com/canva-sdks/canva-skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Canva"
    },
    "description": "Create, edit, review, resize, and brand-check Canva designs with the Canva MCP server.",
    "extensions": {
      "com.openai": {
        "interface": {
          "capabilities": [
            "Interactive",
            "Read",
            "Write"
          ],
          "defaultPrompt": [
            "Resize this Canva design for Instagram and LinkedIn",
            "Review this Canva design and suggest improvements",
            "Check this Canva design against my brand kit",
            "Help me pick the right Canva tool or skill for my task"
          ],
          "developerName": "Canva",
          "displayName": "Canva",
          "longDescription": "Use Canva in Codex to create, resize, review, brand-check, and edit Canva designs with the Canva MCP server.",
          "privacyPolicyURL": "https://www.canva.com/policies/privacy-policy/",
          "shortDescription": "Create and manage Canva designs",
          "termsOfServiceURL": "https://www.canva.com/policies/terms-of-use/",
          "websiteURL": "https://www.canva.com/developers/"
        },
        "mcpServers": "./com.openai/.mcp.json",
        "skills": [
          "./skills/canva-agent-guide",
          "./skills/canva-autofill",
          "./skills/canva-brand-check",
          "./skills/canva-bulk-create",
          "./skills/canva-cli",
          "./skills/canva-create-flyer",
          "./skills/canva-design-feedback",
          "./skills/canva-edit-design",
          "./skills/canva-implement-feedback",
          "./skills/canva-instagram-post",
          "./skills/canva-resize-for-social-media"
        ]
      }
    },
    "homepage": "https://www.canva.com/developers/",
    "keywords": [
      "canva",
      "design",
      "presentation",
      "social media",
      "brand kit",
      "ai generation",
      "flyer",
      "poster",
      "graphic design",
      "marketing"
    ],
    "name": "canva",
    "repository": "https://github.com/canva-sdks/canva-skills",
    "version": "1.1.0"
  },
  "skills": {
    "branded-presentation": "plugins/canva/inactive-skills/branded-presentation",
    "canva-agent-guide": "plugins/canva/skills/canva-agent-guide",
    "canva-autofill": "plugins/canva/skills/canva-autofill",
    "canva-brand-check": "plugins/canva/skills/canva-brand-check",
    "canva-bulk-create": "plugins/canva/skills/canva-bulk-create",
    "canva-cli": "plugins/canva/skills/canva-cli",
    "canva-create-flyer": "plugins/canva/skills/canva-create-flyer",
    "canva-design-feedback": "plugins/canva/skills/canva-design-feedback",
    "canva-edit-design": "plugins/canva/skills/canva-edit-design",
    "canva-implement-feedback": "plugins/canva/skills/canva-implement-feedback",
    "canva-instagram-post": "plugins/canva/skills/canva-instagram-post",
    "canva-resize-for-social-media": "plugins/canva/skills/canva-resize-for-social-media",
    "classroom-helper": "plugins/canva/inactive-skills/classroom-helper",
    "design-translation": "plugins/canva/inactive-skills/design-translation",
    "generate-deck": "plugins/canva/inactive-skills/generate-deck",
    "presentation-time-fitting": "plugins/canva/inactive-skills/presentation-time-fitting"
  },
  "requiredRuntimes": [],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.openai/.mcp.json": "plugins/canva/.mcp.json"
  },
  "mcpServers": {
    "canva": {
      "type": "streamable-http",
      "url": "https://mcp.canva.com/mcp"
    }
  },
  "meta": {
    "description": "Create, edit, review, resize, and brand-check Canva designs with the Canva MCP server",
    "homepage": "https://github.com/canva-sdks/canva-skills"
  },
  "import": {
    "input": "canva-sdks/canva-skills",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "plugins/canva/.cursor/skills",
        "message": "symlink to plugins/canva/skills, followed"
      },
      {
        "path": "plugins/canva/inactive-skills/branded-presentation/SKILL.md/name",
        "message": "skill name \"canva-branded-presentation\" must match directory name \"branded-presentation\""
      },
      {
        "path": "plugins/canva/inactive-skills/classroom-helper/SKILL.md/name",
        "message": "skill name \"canva-classroom-helper\" must match directory name \"classroom-helper\""
      },
      {
        "path": "plugins/canva/inactive-skills/design-translation/SKILL.md/name",
        "message": "skill name \"canva-translate-design\" must match directory name \"design-translation\""
      },
      {
        "path": "plugins/canva/inactive-skills/generate-deck/SKILL.md/name",
        "message": "skill name \"canva-branded-presentation\" is also declared by the skill in directory \"branded-presentation\""
      },
      {
        "path": "plugins/canva/inactive-skills/generate-deck/SKILL.md/name",
        "message": "skill name \"canva-branded-presentation\" must match directory name \"generate-deck\""
      },
      {
        "path": "plugins/canva/inactive-skills/presentation-time-fitting/SKILL.md/name",
        "message": "skill name \"canva-presentation-time-fitting\" must match directory name \"presentation-time-fitting\""
      }
    ]
  }
}
