{
  "name": "explanatory-output-style",
  "version": "1.0.0",
  "src": {
    "owner": "anthropics",
    "repo": "claude-code",
    "rev": "a5b0f2e03aba37ea34e527fe30b2f6aaa4895b9f",
    "hash": "sha256-6SuMeS7qd50OH0m6HOO8VVeu4YaIQFs9uYdeKV9cgwY="
  },
  "sourceUrl": "https://github.com/anthropics/claude-code",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "email": "dickson@anthropic.com",
      "name": "Dickson Tsai"
    },
    "description": "Adds educational insights about implementation choices and codebase patterns (mimics the deprecated Explanatory output style)",
    "name": "explanatory-output-style",
    "version": "1.0.0"
  },
  "skills": {},
  "requiredRuntimes": [
    "bash"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": "plugins/explanatory-output-style/hooks",
    "hooks-handlers": "plugins/explanatory-output-style/hooks-handlers"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Adds educational insights about implementation choices and codebase patterns (mimics the deprecated Explanatory output style)",
    "homepage": "https://github.com/anthropics/claude-code"
  },
  "import": {
    "input": "anthropics/claude-code",
    "flags": [
      "--path-ignore=plugins/frontend-design",
      "--path-ignore=plugins/hookify",
      "--path-ignore=plugins/plugin-dev"
    ],
    "warnings": [
      {
        "path": "plugins/explanatory-output-style/hooks/hooks.json",
        "message": "Claude Code runs this on SessionStart: ${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh"
      }
    ]
  }
}
