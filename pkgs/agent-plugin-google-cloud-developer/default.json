{
  "name": "google-cloud-developer",
  "version": "1.1.20",
  "src": {
    "owner": "google",
    "repo": "skills",
    "rev": "6ec2bf52067fa8b18895b85e85216f7796066bf8",
    "hash": "sha256-7eg+uj3AQUNVkSjds4pAtx2LkNx71/VZwtQSr1yDVJg="
  },
  "sourceUrl": "https://github.com/google/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Google LLC",
      "url": "https://cloud.google.com"
    },
    "description": "Google Cloud guidance for coding agents: first-project onboarding, authentication and credential selection, and safety-critical validation for gcloud CLI commands. Includes the Google Developer Knowledge MCP server for grounded, up-to-date Google Cloud documentation.",
    "extensions": {
      "com.openai": {
        "interface": {
          "capabilities": [
            "Google Cloud onboarding",
            "Authentication guidance",
            "gcloud command safety",
            "Google developer documentation"
          ],
          "category": "Developer Tools",
          "composerIcon": "./com.openai/assets/logo.svg",
          "defaultPrompt": [
            "Help me set up a new Google Cloud project, link billing, and configure local authentication.",
            "Configure Application Default Credentials (ADC) and IAM permissions for my local development environment.",
            "Search official Google Cloud documentation using Developer Knowledge and validate my gcloud CLI commands."
          ],
          "developerName": "Google LLC",
          "displayName": "Google Cloud Developer",
          "logo": "./com.openai/assets/logo.svg",
          "longDescription": "Google Cloud guidance for coding agents: first-project onboarding, authentication and credential selection, and safety-critical validation for gcloud CLI commands.",
          "privacyPolicyURL": "https://policies.google.com/privacy",
          "shortDescription": "Google Cloud guidance & tools",
          "supportURL": "https://cloud.google.com/support",
          "termsOfServiceURL": "https://policies.google.com/terms",
          "websiteURL": "https://cloud.google.com"
        },
        "mcpServers": "./com.openai/.mcp.json",
        "skills": "./skills/"
      }
    },
    "homepage": "https://github.com/google/skills/tree/main/plugins/cloud/google-cloud-developer",
    "keywords": [
      "google-cloud",
      "gcloud",
      "authentication",
      "onboarding"
    ],
    "license": "Apache-2.0",
    "name": "google-cloud-developer",
    "repository": "https://github.com/google/skills",
    "version": "1.1.20"
  },
  "skills": {
    "finding-google-skills": "plugins/cloud/google-cloud-developer/skills/finding-google-skills",
    "gcloud": "plugins/cloud/google-cloud-developer/skills/gcloud",
    "google-cloud-recipe-auth": "plugins/cloud/google-cloud-developer/skills/google-cloud-recipe-auth",
    "google-cloud-recipe-onboarding": "plugins/cloud/google-cloud-developer/skills/google-cloud-recipe-onboarding",
    "retrieving-developer-knowledge": "plugins/cloud/google-cloud-developer/skills/retrieving-developer-knowledge"
  },
  "requiredRuntimes": [],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.openai/.mcp.json": "plugins/cloud/google-cloud-developer/.mcp.json",
    "com.openai/assets": "plugins/cloud/google-cloud-developer/assets"
  },
  "mcpServers": {
    "developer-knowledge": {
      "type": "streamable-http",
      "url": "https://developerknowledge.googleapis.com/mcp"
    }
  },
  "meta": {
    "description": "Google Cloud guidance for coding agents",
    "homepage": "https://github.com/google/skills"
  },
  "import": {
    "input": "https://github.com/google/skills",
    "flags": [
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": "skills",
        "message": "219 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": "plugins/cloud/google-cloud-developer/.codex-plugin/plugin.json",
        "message": "mcpServers: the Codex manifest names none, so Codex reads .mcp.json alone, not what the Claude manifest adds; recorded so"
      },
      {
        "path": "plugins/cloud/google-cloud-developer/assets/logo.svg",
        "message": "larger than 1MiB, so it was not read; a ${PLUGIN_ROOT} reference inside it ships nothing, and a script only it runs is not reported"
      }
    ]
  }
}
