      "microsoft"
    ],
    "license": "MIT",
    "name": "power-apps-mobile-extension",
    "repository": "https://github.com/microsoft/power-platform-skills/",
    "version": "0.2.0"
  },
  "skills": {
    "assemble-ppmplugin": "plugins/power-apps-mobile-extension/skills/assemble-ppmplugin",
    "audit-ppmplugin": "plugins/power-apps-mobile-extension/skills/audit-ppmplugin",
    "build-android-binary": "plugins/power-apps-mobile-extension/skills/build-android-binary",
    "build-ios-binary": "plugins/power-apps-mobile-extension/skills/build-ios-binary",
    "debug-extension": "plugins/power-apps-mobile-extension/skills/debug-extension",
    "design-native-extension-feature": "plugins/power-apps-mobile-extension/skills/design-native-extension-feature",
    "generate-native-extension": "plugins/power-apps-mobile-extension/skills/generate-native-extension",
