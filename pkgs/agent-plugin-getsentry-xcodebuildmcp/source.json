{
  "name": "getsentry-xcodebuildmcp",
  "version": "0-unstable-2026-09-23",
  "src": {
    "owner": "getsentry",
    "repo": "XcodeBuildMCP",
    "rev": "d13ff0c707b0681769cf31da0eb42c4f94ceafff",
