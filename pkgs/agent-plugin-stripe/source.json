        "message": "Claude Code runs this on PostToolBatch: node ${CLAUDE_PLUGIN_ROOT}/scripts/lifecycle/postToolBatch.mjs"
      },
      {
        "path": "providers/claude/plugin/hooks/hooks.json",
        "message": "Claude Code runs this on PostToolUse: node ${CLAUDE_PLUGIN_ROOT}/scripts/lifecycle/postToolUse.mjs"
      },
      {
        "path": "providers/claude/plugin/hooks/hooks.json",
        "message": "Claude Code runs this on PostToolUse: node ${CLAUDE_PLUGIN_ROOT}/scripts/lifecycle/postToolUse.mjs"
      },
      {
        "path": "providers/claude/plugin/hooks/hooks.json",
        "message": "Claude Code runs this on PostToolUseFailure: node ${CLAUDE_PLUGIN_ROOT}/scripts/lifecycle/postToolUseFailure.mjs"
      },
      {
        "path": "providers/claude/plugin/hooks/hooks.json",
        "message": "Claude Code runs this on PostToolUseFailure: node ${CLAUDE_PLUGIN_ROOT}/scripts/lifecycle/postToolUseFailure.mjs"
      },
      {
        "path": "providers/claude/plugin/hooks/hooks.json",
        "message": "Claude Code runs this on SessionStart: node ${CLAUDE_PLUGIN_ROOT}/scripts/lifecycle/sessionStart.mjs"
      },
      {
        "path": "providers/claude/plugin/hooks/hooks.json",
        "message": "Claude Code runs this on UserPromptSubmit: node ${CLAUDE_PLUGIN_ROOT}/scripts/lifecycle/userPromptSubmit.mjs"
      }
    ]
  }
}
