{
  "name": "aks-skills",
  "version": "1.0.16",
  "src": {
    "owner": "microsoft",
    "repo": "skills",
    "rev": "18e05b845d43e869b5701d796abce6e9a49e57db",
    "hash": "sha256-9m/tiEGwHBr8oYKxsp1rCQVLtRmoNw3n/JVR+UKgrzg="
  },
  "sourceUrl": "https://github.com/microsoft/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Microsoft",
      "url": "https://www.microsoft.com"
    },
    "description": "AKS operational skills for troubleshooting, advanced cost-efficiency analysis, known issues, GPU inference, and packet capture.",
    "homepage": "https://github.com/microsoft/github-copilot-for-azure",
    "keywords": [
      "azure",
      "aks",
      "kubernetes",
      "cost-optimization",
      "troubleshooting",
      "known-issues",
      "gpu-inference",
      "packet-capture"
    ],
    "license": "MIT",
    "name": "aks-skills",
    "repository": "https://github.com/microsoft/GitHub-Copilot-for-Azure",
    "version": "1.0.16"
  },
  "skills": {
    "aks-cost-optimization": ".github/plugins/aks-skills/skills/aks-cost-optimization",
    "aks-gpu-inference": ".github/plugins/aks-skills/skills/aks-gpu-inference",
    "aks-known-issues": ".github/plugins/aks-skills/skills/aks-known-issues",
    "aks-network-capture": ".github/plugins/aks-skills/skills/aks-network-capture",
    "aks-troubleshooting": ".github/plugins/aks-skills/skills/aks-troubleshooting",
    "azure-search-nav": ".github/plugins/aks-skills/skills/azure-search-nav"
  },
  "requiredRuntimes": [
    "bash",
    "sh"
  ],
  "dependencies": [
    "powershell"
  ],
  "defaultDependencies": [
    "bash",
    "python3",
    "nodejs"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": ".github/plugins/aks-skills/hooks"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "AKS operational skills for troubleshooting, advanced cost-efficiency analysis, known issues, GPU inference, and packet capture",
    "homepage": "https://github.com/microsoft/skills"
  },
  "import": {
    "input": "microsoft/skills",
    "flags": [
      "--dependency=powershell",
      "--pkgs-dir=pkgs"
    ],
    "warnings": [
      {
        "path": ".github/skills",
        "message": "13 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": ".github/plugins/aks-skills/hooks/claude-hooks.json",
        "message": "Claude Code runs this on PostToolUse: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code"
      },
      {
        "path": ".github/plugins/aks-skills/hooks/claude-hooks.json",
        "message": "Claude Code runs this on SessionStart: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness claude-code"
      },
      {
        "path": "com.anthropic.claude-code/hooks/scripts/pluginPathAllowPattern.sh",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      }
    ]
  }
}
