{
  "name": "azure-local-skills",
  "version": "1.0.17",
  "src": {
    "owner": "microsoft",
    "repo": "skills",
    "rev": "146f047391145d5c16c981ca8774fb722090efba",
    "hash": "sha256-UJuaTsp6qA/oKLvRCyGQHWq25iQdKtsHlUphzbmuXmk="
  },
  "sourceUrl": "https://github.com/microsoft/skills",
  "manifest": {
    "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
    "author": {
      "name": "Microsoft",
      "url": "https://www.microsoft.com"
    },
    "description": "Azure Local skills covering standard deployments (Azure Stack HCI, 1-16 node hyperconverged, rack-aware clusters) and multi-rack (rack scale) deployments built on Network Fabric Controller, Cluster Manager, and managed network fabric.",
    "homepage": "https://github.com/microsoft/github-copilot-for-azure",
    "keywords": [
      "azure",
      "azure-local",
      "azure-stack-hci",
      "hybrid",
      "arc",
      "multi-rack",
      "network-fabric"
    ],
    "license": "MIT",
    "name": "azure-local-skills",
    "repository": "https://github.com/microsoft/github-copilot-for-azure",
    "version": "1.0.17"
  },
  "skills": {
    "azure-local": ".github/plugins/azure-local-skills/skills/azure-local",
    "azure-local-multi-rack": ".github/plugins/azure-local-skills/skills/azure-local-multi-rack"
  },
  "requiredRuntimes": [
    "bash",
    "npx"
  ],
  "pluginRootPaths": {
    "com.anthropic.claude-code/hooks": ".github/plugins/azure-local-skills/hooks"
  },
  "mcpServers": {
    "azure": {
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "command": "npx",
      "type": "stdio"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "meta": {
    "description": "Azure Local skills covering standard deployments (Azure Stack HCI, 1-16 node hyperconverged, rack-aware clusters) and multi-rack (rack scale) deployments built on Network Fabric Controller, Cluster Manager, and managed network fabric",
    "homepage": "https://github.com/microsoft/skills"
  },
  "import": {
    "input": "microsoft/skills",
    "flags": [],
    "warnings": [
      {
        "path": ".github/skills",
        "message": "13 SKILL.md outside every imported plugin, not imported"
      },
      {
        "path": ".github/plugins/azure-local-skills/hooks/claude-hooks.json",
        "message": "Claude Code runs this on PostToolUse: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\""
      },
      {
        "path": ".github/plugins/azure-local-skills/hooks/claude-hooks.json",
        "message": "Claude Code runs this on SessionStart: bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\""
      },
      {
        "path": "com.anthropic.claude-code/hooks/scripts/pluginPathAllowPattern.sh",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      },
      {
        "path": "com.anthropic.claude-code/hooks/scripts/track-telemetry.js",
        "message": "script has no shebang; the build links no interpreter for it and this package is not self-contained"
      }
    ]
  }
}
